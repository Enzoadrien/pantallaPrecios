<Window x:Name="VentanaCajasWindow" x:Class="Priceio.VentanaCajas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cajas" FontFamily="Arial Rounded MT"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#FFECF0F1"
        SizeChanged="VentanaCajasWindow_SizeChanged">

    <Window.Resources>

        <!-- Estilo botón plano reutilizable (header) -->
        <Style x:Key="BotonHeader" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de los botones "Caja" -->
        <Style x:Key="CajaButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="#FF3498DB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="14" Background="{TemplateBinding Background}"
                                BorderBrush="#FF2980B9" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF5DADE2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF21618C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Encabezado / controles ===== -->
        <Border Grid.Row="0" Background="#FF2C3E50" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="Cantidad de cajas (0-100):" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtCantidad" Width="70" Height="32" FontSize="16"
                         Margin="10,0,10,0" VerticalContentAlignment="Center" TextAlignment="Center"
                         Text="10" PreviewTextInput="TxtCantidad_PreviewTextInput"
                         TextChanged="TxtCantidad_TextChanged"/>
                <Button x:Name="BtnGenerar" Content="Generar cajas" Width="140" Height="36"
                        Style="{StaticResource BotonHeader}" Background="#FF27AE60"
                        Margin="0,0,10,0" Click="BtnGenerar_Click"/>
                <Button x:Name="BtnCerrar" Content="Cerrar" Width="100" Height="36"
                        Style="{StaticResource BotonHeader}" Background="#FFE74C3C"
                        Click="BtnCerrar_Click"/>
            </StackPanel>
        </Border>

        <!-- ===== Área de cajas (con scroll) ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="PanelCajas" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="15"/>
        </ScrollViewer>

        <!-- ===== Pie / info ===== -->
        <Border Grid.Row="2" Background="#FF2C3E50" Padding="8">
            <TextBlock x:Name="TxtInfo" Foreground="White" FontSize="13" HorizontalAlignment="Center"
                       Text="Indica la cantidad de cajas y presiona &quot;Generar cajas&quot;."/>
        </Border>

    </Grid>
</Window>
