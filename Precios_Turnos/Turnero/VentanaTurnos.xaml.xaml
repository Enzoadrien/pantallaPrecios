<Window x:Class="Priceio.VentanaTurnos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turnero"
        WindowState="Maximized"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="Black">

    <Grid>

        <!-- Imagen de fondo -->
        <Image x:Name="ImgFondo"
               x:FieldModifier="public"
               Stretch="UniformToFill"
               Opacity="1"
               Visibility="Collapsed"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

        <!-- ── Indicador de conexión arriba a la izquierda ── -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="24,18,0,0">
            <Ellipse x:Name="IndConexion"
                     x:FieldModifier="public"
                     Width="12" Height="12"
                     Fill="#EF4444"
                     VerticalAlignment="Center"
                     Margin="0,0,6,0"/>
            <TextBlock x:Name="TxtConexion"
                       x:FieldModifier="public"
                       Text="Sin conexión"
                       Foreground="#94A3B8"
                       FontSize="12"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ── Botones arriba a la derecha ── -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,18,24,0">

            <!-- Botón Reset -->
            <Button x:Name="BtnResetTurno"
                    Content="↺"
                    Width="34" Height="34"
                    FontSize="15" FontWeight="Bold"
                    Background="Black" Foreground="#F59E0B"
                    BorderThickness="1" BorderBrush="Black"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    ToolTip="Reiniciar contador de turnos"
                    Click="BtnResetTurno_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#78350F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Botón Cerrar -->
            <Button x:Name="BtnCerrar"
                    Content="✕"
                    Width="34" Height="34"
                    FontSize="15" FontWeight="Bold"
                    Background="Black" Foreground="#EF4444"
                    BorderThickness="1" BorderBrush="Black"
                    Cursor="Hand"
                    Click="BtnCerrar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7F1D1D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- ── Contenido central ── -->
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- LOGO -->
                <Border x:Name="ContenedorLogo"
                        x:FieldModifier="public"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,32">
                    <Image x:Name="ImgLogo"
                           x:FieldModifier="public"
                           MaxHeight="120"
                           MaxWidth="320"
                           Stretch="Uniform"/>
                </Border>

                <!-- Línea decorativa superior -->
                <Rectangle Height="2" Width="60"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Black" Offset="0"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Títulos -->
                <TextBlock Text="S I S T E M A   D E   T U R N O S"
                           FontSize="15"
                           FontWeight="Light"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Obtenga su turno"
                           FontSize="42"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#F1F5F9"
                           Margin="0,0,0,48"/>

                <!-- BOTÓN PRINCIPAL -->
                <Button x:Name="BtnObtenerTurno"
                        x:FieldModifier="public"
                        Width="320" Height="90"
                        Cursor="Hand"
                        Click="BtnObtenerTurno_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BordeBTN"
                                    CornerRadius="16"
                                    Padding="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0EA5E9" Offset="0"/>
                                        <GradientStop Color="#6366F1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#0EA5E9"
                                                      BlurRadius="28"
                                                      ShadowDepth="0"
                                                      Opacity="0.55"/>
                                </Border.Effect>
                                <StackPanel Orientation="Vertical"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="O B T E N E R   T U R N O"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Presione aquí"
                                               FontSize="12"
                                               FontWeight="Light"
                                               Foreground="#BAE6FD"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BordeBTN" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BordeBTN" Property="Opacity" Value="0.70"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BordeBTN" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Número de turno -->
                <Border x:Name="ContenedorNumero"
                        Visibility="Collapsed"
                        Margin="0,44,0,0"
                        HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="T U   N Ú M E R O   E S"
                                   FontSize="13"
                                   FontWeight="Light"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   Margin="0,0,0,6"/>
                        <Border CornerRadius="20"
                                Padding="40,10"
                                HorizontalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="Black" Offset="0"/>
                                    <GradientStop Color="Black" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="Black" Offset="0"/>
                                    <GradientStop Color="Black" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.BorderThickness>1.5</Border.BorderThickness>
                            <Border.Effect>
                                <DropShadowEffect Color="Black"
                                                  BlurRadius="20"
                                                  ShadowDepth="0"
                                                  Opacity="0.3"/>
                            </Border.Effect>
                            <TextBlock x:Name="TxtNumeroTurno"
                                       Text=""
                                       FontSize="88"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="White"/>
                        </Border>
                        <TextBlock x:Name="TxtMensaje"
                                   Text=""
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

    </Grid>
</Window>