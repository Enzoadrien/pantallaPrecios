<Window x:Class="Precios_Turnos.PropiedadesLabelTurno"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Propiedades" Height="400" Width="270" WindowStyle="None" Opacity="0.9" Background="#FFD2CBCB" AllowsTransparency="True" KeyDown="Window_KeyDown" ResizeMode="NoResize" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="35*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Background="#FF989090" Grid.ColumnSpan="5"  MouseLeftButtonDown="StackPanel_MouseLeftButtonDown">
            <Label Content="Propiedades texto"  VerticalAlignment="Top" FontFamily="Arial Rounded MT" Grid.ColumnSpan="2" HorizontalAlignment="Left" FontSize="18" FontWeight="Bold"/>
        </StackPanel>
        <Button x:Name="Salir" Content="X" HorizontalAlignment="Right"  VerticalAlignment="Top"  Click="Salir_Click" Grid.Column="5" FontFamily="Arial Rounded MT" HorizontalContentAlignment="Center" Width="24" Height="24" >
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#FF989090"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFC42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Label x:Name="lblNombre" Content="Nombre:" Grid.ColumnSpan="2" Grid.Row="1" FontFamily="Arial Rounded MT" FontSize="14"/>
        <TextBox x:Name="NombreControl" Grid.Row="1" Grid.ColumnSpan="3" Text="" Grid.Column="2" VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" IsReadOnly="True" Margin="0,0,5,0"/>
        <Label x:Name="lblTipoControl" Content="Tipo:" Grid.Row="2" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <TextBox x:Name="TipoControl" Grid.Row="2" Grid.ColumnSpan="3" Text="" Grid.Column="2" VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" IsReadOnly="True" Margin="0,0,5,0"/>
        <Label x:Name="lblContenido" Content="Contenido:" Grid.Row="3" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <TextBox x:Name="Contenido" Grid.Row="3" Grid.ColumnSpan="3" Text="" Grid.Column="2"  VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" TextChanged="Contenido_TextChanged" Margin="0,0,5,0"/>
        <Label x:Name="lblFuente" Content="Fuente:" Grid.Row="4" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <ComboBox x:Name="cbxFuente" ItemsSource="{Binding Source={x:Static Fonts.SystemFontFamilies}}"
                  FontSize="14" Grid.Column="2" Grid.Row="4" Grid.ColumnSpan="3" SelectionChanged="cbxFuente_SelectionChanged" Margin="0,0,5,0">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock FontFamily="{Binding .}" Text="{Binding Source}" ToolTip="{Binding Source}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Label x:Name="lblTamano" Content="Tamaño:" Grid.ColumnSpan="2" Grid.Row="5" FontFamily="Arial Rounded MT" FontSize="14"/>
        <ComboBox x:Name="cbxTamano" Grid.Column="2"  Grid.Row="5" Grid.ColumnSpan="3" FontFamily="Arial Rounded MT" FontSize="14" SelectionChanged="cbxTamano_SelectionChanged" SelectedValuePath="Tag" Margin="0,0,5,0">
            <ComboBoxItem Content="12 px" Tag="12"/>
            <ComboBoxItem Content="14 px" Tag="14"/>
            <ComboBoxItem Content="16 px" Tag="16"/>
            <ComboBoxItem Content="18 px" Tag="18"/>
            <ComboBoxItem Content="20 px" Tag="20"/>
            <ComboBoxItem Content="22 px" Tag="22"/>
            <ComboBoxItem Content="24 px" Tag="24"/>
            <ComboBoxItem Content="28 px" Tag="28"/>
            <ComboBoxItem Content="30 px" Tag="30"/>
            <ComboBoxItem Content="32 px" Tag="32"/>
            <ComboBoxItem Content="34 px" Tag="34"/>
            <ComboBoxItem Content="36 px" Tag="36"/>
            <ComboBoxItem Content="38 px" Tag="38"/>
            <ComboBoxItem Content="40 px" Tag="40"/>
            <ComboBoxItem Content="42 px" Tag="42"/>
            <ComboBoxItem Content="44 px" Tag="44"/>
            <ComboBoxItem Content="46 px" Tag="46"/>
            <ComboBoxItem Content="48 px" Tag="48"/>
            <ComboBoxItem Content="52 px" Tag="52"/>
            <ComboBoxItem Content="56 px" Tag="56"/>
            <ComboBoxItem Content="64 px" Tag="64"/>
            <ComboBoxItem Content="68 px" Tag="68"/>
            <ComboBoxItem Content="72 px" Tag="72"/>
            <ComboBoxItem Content="76 px" Tag="76"/>
            <ComboBoxItem Content="84 px" Tag="84"/>
            <ComboBoxItem Content="88 px" Tag="88"/>
            <ComboBoxItem Content="92 px" Tag="92"/>
            <ComboBoxItem Content="96 px" Tag="96"/>
        </ComboBox>
        <CheckBox x:Name="chkNegrita" Content="Negrita" Grid.Row="6" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" Checked="chkNegrita_Checked" HorizontalAlignment="Center" Unchecked="chkNegrita_Unchecked" VerticalAlignment="Center" FontWeight="Bold"/>
        <CheckBox x:Name="chkCursiva" Content="Cursiva" Grid.Row="6" Grid.Column="3" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" Checked="chkCursiva_Checked" Unchecked="chkCursiva_Unchecked" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic"/>
        <Label x:Name="lblColor" Content="Color" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" FontFamily="Arial Rounded MT" FontSize="14"/>
        <Label x:Name="lblColorFuente" Content="Fuente:" Grid.Row="8" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <Rectangle x:Name="btnColorFuente" Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="8" Fill="Black" Stroke="#FF707070" MouseLeftButtonDown="btnColorFuente_MouseLeftButtonDown" Margin="0,0,5,0"/>
        <Label x:Name="lblColorFondo" Content="Fondo:" Grid.Row="9" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <Rectangle x:Name="btnColorFondo" Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="9" Fill="Black" Stroke="#FF707070" MouseLeftButtonDown="btnColorFondo_MouseLeftButtonDown" Margin="0,0,5,0"/>
        <Label x:Name="lblOpacidad" Content="Opacidad:" Grid.Row="10" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <Slider x:Name="Opacidad" Minimum="0" Maximum="1" SmallChange="0.1" LargeChange="0.3" Grid.Column="2" Grid.ColumnSpan="3" HorizontalAlignment="Center" Grid.Row="10" Width="120" VerticalAlignment="Center" ValueChanged="Opacidad_ValueChanged" MouseWheel="Opacidad_MouseWheel"/>
        <Label x:Name="lblCoordenadas" Content="Coordenadas" Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="3" FontFamily="Arial Rounded MT" FontSize="14"/>
        <Label x:Name="lblCoordenadaX" Content="X:" Grid.Row="12"  FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Right"/>
        <TextBox x:Name="CoordenadaX" Grid.Row="12" Text="" Grid.Column="1"  VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown" PreviewKeyUp="txtAlpha_PreviewKeyUp" LostFocus="Coordenada_LostFocus" TextChanged="Coordenada_TextChanged" IsReadOnly="True"/>
        <Label x:Name="lblCoordenadaY" Content="Y:" Grid.Row="12" Grid.Column="2"  FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Right"/>
        <TextBox x:Name="CoordenadaY" Grid.Row="12" Text="" Grid.Column="3"  VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown" PreviewKeyUp="txtAlpha_PreviewKeyUp" LostFocus="Coordenada_LostFocus" TextChanged="Coordenada_TextChanged" IsReadOnly="True"/>
        <StackPanel Grid.Row="13"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Margin="0,5,5,5" Grid.Column="3" Grid.ColumnSpan="2">
            <Button x:Name="btnBorrar"
              Content="Eliminar"
              IsDefault="True"
              Width="60"
              Height="20"
              Margin="0,0,0,0"
              TabIndex="0"
              FontFamily="Arial Rounded MT" 
              FontSize="14" Click="btnBorrar_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFC42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
