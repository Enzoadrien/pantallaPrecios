<Window x:Class="Precios_Turnos.MostrarVentanaSplash"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Precios_Turnos"
        mc:Ignorable="d"
        Title="Splash" Height="800" Width="600" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" MouseRightButtonUp="Principal_MouseRightButtonUp" Loaded="Window_Loaded" KeyDown="Window_KeyDown" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" Activated="Window_Activated">
    <Window.Resources>
        <ContextMenu x:Key="cmdPrincipalContexMenu">
            <MenuItem x:Name="MenuAgregarTexto" Header="Agregar texto" PreviewMouseLeftButtonDown="MenuAgregarTexto_PreviewMouseLeftButtonDown"/>
            <MenuItem x:Name="MenuAgregarImagen" Header="Agregar imagen" PreviewMouseLeftButtonDown="MenuAgregarImagen_PreviewMouseLeftButtonDown"/>
            <MenuItem x:Name="Turnero" Header="Turnero">
                <MenuItem x:Name="MenuMostrarOcultarTurno" Header="Agregar turno" PreviewMouseLeftButtonDown="MenuMostrarOcultarTurno_PreviewMouseLeftButtonDown"/>
                <MenuItem x:Name="MenuMostrarOcultarEquipo" Header="Agregar equipo" PreviewMouseLeftButtonDown="MenuMostrarOcultarEquipo_PreviewMouseLeftButtonDown" />
                <MenuItem x:Name="MenuMostrarOcultarNombreEquipo" Header="Agregar nombre equipo" PreviewMouseLeftButtonDown="MenuMostrarOcultarNombreEquipo_PreviewMouseLeftButtonDown" />
                <Separator />
                <MenuItem x:Name="MenuMostrarOcultarTurnoAnt" Header="Agregar turnos anteriores" PreviewMouseLeftButtonDown="MenuMostrarOcultarTurnoAnt_PreviewMouseLeftButtonDown" />
                <MenuItem x:Name="MenuMostrarOcultarEquipoAnt" Header="Agregar numero equipos anteriores" PreviewMouseLeftButtonDown="MenuMostrarOcultarEquipoAnt_PreviewMouseLeftButtonDown" />
            </MenuItem>
            <MenuItem x:Name="Verificador" Header="Verificador">
                <MenuItem x:Name="MenuMostrarOcultarTablaDatos" Header="Agregar tabla de datos" PreviewMouseLeftButtonDown="AgregarTablaDatos_PreviewMouseLeftButtonDown"/>
            </MenuItem>
            <MenuItem x:Name="CajeroATM" Header="Cajero ATM">
                <MenuItem x:Name="MenuMostrarOcultarTablaDatosCajeroATM" Header="Agregar tabla de datos"/>
            </MenuItem>
            <Separator />
            <MenuItem x:Name="MenuListaObjetos" Header="Lista de objetos"/>
            <MenuItem x:Name="Propiedades" Header="Propiedades fondo" PreviewMouseLeftButtonDown="Propiedades_PreviewMouseLeftButtonDown"/>
            <MenuItem x:Name="PropiedadesBorde" Header="Propiedades borde" PreviewMouseLeftButtonDown="PropiedadesBorde_PreviewMouseLeftButtonDown"/>
            <Separator />
            <MenuItem x:Name="MenuReiniciarDiseno" Header="Reiniciar diseño" PreviewMouseLeftButtonDown="MenuReiniciarDiseno_PreviewMouseLeftButtonDown"/>
            <MenuItem x:Name="MenuSalir" Header="Salir" PreviewMouseLeftButtonDown="MenuSalir_PreviewMouseLeftButtonDown"/>
        </ContextMenu>
        <ContextMenu x:Key="cmdContexMenu">
            <MenuItem x:Name="MenuTraerFrente" Header="Traer al frente" PreviewMouseLeftButtonDown="MenuTraerFrente_PreviewMouseLeftButtonDown" />
            <MenuItem x:Name="MenuPropiedades" Header="Propiedades" PreviewMouseLeftButtonDown="MenuPropiedades_PreviewMouseLeftButtonDown"/>
            <Separator />
            <MenuItem x:Name="MenuEliminar" Header="Eliminar" PreviewMouseLeftButtonDown="MenuEliminar_PreviewMouseLeftButtonDown"/>
        </ContextMenu>
    </Window.Resources>
    <Grid x:Name="Principal" PreviewMouseMove="Principal_PreviewMouseMove" PreviewMouseLeftButtonDown="Principal_PreviewMouseDown" PreviewMouseLeftButtonUp="Principal_PreviewMouseUp" MouseLeftButtonDown="Principal_MouseLeftButtonDown" Background="White">
        <Grid x:Name="Base"></Grid>
        <Image x:Name="Fondo" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill" />
        <Border x:Name="Borde" BorderBrush="Black" BorderThickness="3" Panel.ZIndex="996"/>
        <Label x:Name="ModoEdicion" Content="Modo edición" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="18" Foreground="Red" FontFamily="Arial Rounded MT" Panel.ZIndex="1000"/>
        <Label x:Name="Coordenadas" Content="Coordenadas: 1920X, 1080Y" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="14" Foreground="Red" FontFamily="Arial Rounded MT" Panel.ZIndex="1000" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
