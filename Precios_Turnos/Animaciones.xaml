<Window x:Class="Precios_Turnos.Animaciones"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Precios_Turnos"
        mc:Ignorable="d"
       Title="Animaciones" Height="420" Width="200" WindowStyle="None" Opacity="0.9" Background="#FFD2CBCB" AllowsTransparency="True" KeyDown="Window_KeyDown" ResizeMode="NoResize" Closed="Window_Closed" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="35*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Background="#FF989090" Grid.ColumnSpan="5"  MouseLeftButtonDown="StackPanel_MouseLeftButtonDown">
            <Label Content="Animaciones"  VerticalAlignment="Top" FontFamily="Arial Rounded MT" Grid.ColumnSpan="2" HorizontalAlignment="Left" FontSize="18" FontWeight="Bold"/>
        </StackPanel>
        <Button x:Name="Salir" Content="X" HorizontalAlignment="Right"  VerticalAlignment="Top"  Click="Salir_Click" Grid.Column="5" FontFamily="Arial Rounded MT" HorizontalContentAlignment="Center" Width="24" Height="24" >
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#FF989090"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFC42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <CheckBox x:Name="chkMover" Content="Mover" Grid.Row="1" Grid.ColumnSpan="4" FontFamily="Arial Rounded MT" FontSize="14" 
                 VerticalAlignment="Center" Margin="0,0,5,0" HorizontalAlignment="Right"/>
        <CheckBox x:Name="chkHorizontal" Content="Horizontal" Grid.Row="2" Grid.ColumnSpan="4" FontFamily="Arial Rounded MT" FontSize="14" 
                 VerticalAlignment="Center" Margin="0,0,5,0" HorizontalAlignment="Right"/>
        <Label x:Name="lblDirrecionH" Content="Dirección:" Grid.Row="3" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Left" Margin="5,0,0,0"/>
        <ComboBox x:Name="cbxDireccionH" Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" SelectedValuePath="Tag" Margin="0,0,5,0" SelectedIndex="0">
            <ComboBoxItem Content="Derecha" Tag="D"/>
            <ComboBoxItem Content="Izquierda" Tag="I"/>
        </ComboBox>
        <Label x:Name="lblVelocidadMH" Content="Velocidad:" Grid.Row="4" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Left" Margin="5,0,0,0"/>
        <TextBox x:Name="VelocidadMH" VerticalContentAlignment="Center" Grid.Row="4" Grid.Column="2" FontFamily="Arial Rounded MT" FontSize="14" Text="500"/>
        <Label x:Name="lblSMH" Content="ms" Grid.Row="4" Grid.Column="4" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Left"/>
        <CheckBox x:Name="chkVertical" Content="Vertical" Grid.Row="5" Grid.ColumnSpan="4" FontFamily="Arial Rounded MT" FontSize="14" 
                 VerticalAlignment="Center" Margin="0,0,5,0" HorizontalAlignment="Right"/>
        <Label x:Name="lblDirrecionV" Content="Dirección:" Grid.Row="6" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Left" Margin="5,0,0,0"/>
        <ComboBox x:Name="cbxDireccionV" Grid.Column="2" Grid.Row="6" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" SelectedValuePath="Tag" Margin="0,0,5,0" SelectedIndex="0">
            <ComboBoxItem Content="Arriba" Tag="A"/>
            <ComboBoxItem Content="Abajo" Tag="B"/>
        </ComboBox>
        <Label x:Name="lblVelocidadMV" Content="Velocidad:" Grid.Row="7" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Left" Margin="5,0,0,0"/>
        <TextBox x:Name="VelocidadMV" VerticalContentAlignment="Center" Grid.Row="7" Grid.Column="2" FontFamily="Arial Rounded MT" FontSize="14" Text="500"/>
        <Label x:Name="lblSMV" Content="ms" Grid.Row="7" Grid.Column="4" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Left"/>

        <CheckBox x:Name="chkEscalar" Content="Escalar" Grid.Row="8" Grid.ColumnSpan="4" FontFamily="Arial Rounded MT" FontSize="14" 
                 VerticalAlignment="Center" Margin="0,0,5,0" Checked="chkEscalar_Checked" Unchecked="chkEscalar_Unchecked" HorizontalAlignment="Right"/>
        <Label x:Name="lblTamanoE" Content="Tamaño:" Grid.Row="9" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Left" Margin="5,0,0,0"/>
        <ComboBox x:Name="cbxTamanoE" Grid.Column="2"  Grid.Row="9" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" SelectedValuePath="Tag" Margin="0,0,5,0" SelectionChanged="cbxTamano_SelectionChanged" SelectedIndex="0">
            <ComboBoxItem Content="1X" Tag="0.1"/>
            <ComboBoxItem Content="2X" Tag="0.2"/>
            <ComboBoxItem Content="3X" Tag="0.3"/>
            <ComboBoxItem Content="4X" Tag="0.4"/>
            <ComboBoxItem Content="5X" Tag="0.5"/>
         </ComboBox>
        <Label x:Name="lblVelocidadE" Content="Velocidad:" Grid.Row="10" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Left" Margin="5,0,0,0"/>
        <TextBox x:Name="VelocidadE" VerticalContentAlignment="Center" Grid.Row="10" Grid.Column="2" FontFamily="Arial Rounded MT" FontSize="14" Text="500"/>
        <Label x:Name="lblSE" Content="ms" Grid.Row="10" Grid.Column="4" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Left"/>
    </Grid>
</Window>
