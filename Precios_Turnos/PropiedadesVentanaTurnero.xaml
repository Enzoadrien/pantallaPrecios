<Window x:Class="Precios_Turnos.PropiedadesVentanaTurnero"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Precios_Turnos"
        mc:Ignorable="d"
        Title="Propiedades" Height="310" Width="270" WindowStyle="None" Opacity="0.9" Background="#FFD2CBCB" AllowsTransparency="True" KeyDown="Window_KeyDown" ResizeMode="NoResize" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="35*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Background="#FF989090" Grid.ColumnSpan="5">
            <Label Content="Propiedades ventana"  VerticalAlignment="Top" FontFamily="Arial Rounded MT" Grid.ColumnSpan="2" HorizontalAlignment="Left" FontSize="18" FontWeight="Bold"/>
        </StackPanel>
        <Button x:Name="Salir" Content="X" HorizontalAlignment="Right"  VerticalAlignment="Top"  Click="Salir_Click" Grid.Column="5" FontFamily="Arial Rounded MT" HorizontalContentAlignment="Center" Width="24" Height="24" >
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#FF989090"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFC42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Label x:Name="lblFondo" Content="Fondo:" Grid.ColumnSpan="3" Grid.Row="1" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="1"/>
        <Label x:Name="lblColorFondo" Content="Color solido:" Grid.Row="2" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <Rectangle x:Name="btnColorFondo" Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="2" Fill="Black" Stroke="#FF707070" MouseLeftButtonDown="btnColorFondo_MouseLeftButtonDown" Margin="0,0,5,0"/>
        <Label x:Name="lblImagen" Content="Abrir imagen:" Grid.Row="3" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <TextBox x:Name="ContenidoTextBox" VerticalContentAlignment="Center" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3" FontFamily="Arial Rounded MT" FontSize="14" IsReadOnly="True" Margin="0,0,5,0"/>
        <StackPanel Grid.Row="3"
        HorizontalAlignment="Right"
        Orientation="Horizontal"
        Margin="0,5,7,5" Grid.Column="4" >
            <Button x:Name="btnAbrir"
      Content="..."
      Click="btnAbrir_Click"
      IsDefault="True"
      Width="20"
      Height="20"
      Margin="0,0,0,0"
      TabIndex="0"
      FontFamily="Arial Rounded MT" 
      FontSize="14">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF0E596D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <Label x:Name="lblOpacidad" Content="Opacidad:" Grid.Row="4" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <Slider x:Name="Opacidad" Minimum="0" Maximum="1" SmallChange="0.1" LargeChange="0.3" Grid.Column="2" Grid.ColumnSpan="3" HorizontalAlignment="Center" Grid.Row="4" Width="120" VerticalAlignment="Center" ValueChanged="Opacidad_ValueChanged" MouseWheel="Opacidad_MouseWheel" IsEnabled="False"/>
        <Label x:Name="lblBorde" Content="Borde:" Grid.ColumnSpan="3" Grid.Row="5" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="1"/>
        <Label x:Name="lblColorBorde" Content="Color:" Grid.Row="6" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <Rectangle x:Name="btnColorBorde" Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="6" Fill="Black" Stroke="#FF707070" MouseLeftButtonDown="btnColorFondoBorde_MouseLeftButtonDown" Margin="0,0,5,0"/>
        <Label x:Name="lblGrosor" Content="Grosor:" Grid.Row="7" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <ComboBox x:Name="cbxGrosor" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="2" Grid.Row="7" Grid.ColumnSpan="3"  SelectedValuePath="Tag" Margin="0,0,5,0" SelectionChanged="cbxGrosor_SelectionChanged">
            <ComboBoxItem Content="0" Tag="0"/>
            <ComboBoxItem Content="1" Tag="1"/>
            <ComboBoxItem Content="2" Tag="2"/>
            <ComboBoxItem Content="3" Tag="3"/>
            <ComboBoxItem Content="4" Tag="4"/>
            <ComboBoxItem Content="5" Tag="5"/>
            <ComboBoxItem Content="6" Tag="6"/>
            <ComboBoxItem Content="7" Tag="7"/>
            <ComboBoxItem Content="8" Tag="8"/>
            <ComboBoxItem Content="9" Tag="9"/>
            <ComboBoxItem Content="10" Tag="10"/>
        </ComboBox>
        <Label x:Name="lblTamano" Content="Tamaño ventana:" Grid.Row="8" FontFamily="Arial Rounded MT" FontSize="14" Grid.ColumnSpan="3" Grid.Column="1"/>
        <Label x:Name="lblAncho" Content="Ancho:" Grid.Row="9" FontFamily="Arial Rounded MT" FontSize="14" Grid.ColumnSpan="2"/>
        <TextBox x:Name="Ancho" Grid.Row="9" Text="" Grid.ColumnSpan="2" VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown" Grid.Column="1" Margin="5,0,45,0" TextChanged="Ancho_TextChanged"/>
        <Label x:Name="lblLargoPX" Content="px" Grid.Row="9" Grid.Column="2" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Center" Margin="0,0,15,0"/>
        <Label x:Name="lblAlto" Content="Alto:" Grid.Row="9" Grid.Column="2" FontFamily="Arial Rounded MT" FontSize="14" Grid.ColumnSpan="3" HorizontalAlignment="Right" Margin="0,0,85,0"/>
        <TextBox x:Name="Alto" Grid.Row="9" Text="" Grid.Column="3" Grid.ColumnSpan="2" VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown" Margin="25,0,30,0" TextChanged="Alto_TextChanged"/>
        <Label x:Name="lblAnchoPX" Content="px" Grid.Row="9" Grid.Column="4" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Right" Margin="0,0,5,0"/>
    </Grid>
</Window>
