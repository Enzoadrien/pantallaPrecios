<Window x:Name="VentanaPrincipal" x:Class="Precios_Turnos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Precios_Turnos"
        mc:Ignorable="d"
        Title="Priceio" Height="600" Width="920" SizeChanged="Window_SizeChanged" KeyDown="Window_KeyDown" WindowStartupLocation="CenterScreen" FontFamily="Arial Rounded MT" MouseRightButtonUp="Principal_MouseRightButtonUp" MinWidth="920" MinHeight="600" Closed="Window_Closed" Icon="/logoapp.png" Activated="VentanaPrincipal_Activated">
    <Window.Resources>
        <ContextMenu x:Key="cmdPrincipalContexMenu">
            <MenuItem x:Name="MenuAgregarTexto" Header="Agregar texto" PreviewMouseLeftButtonDown="MenuAgregarTexto_PreviewMouseLeftButtonDown"/>
            <MenuItem x:Name="MenuAgregarImagen" Header="Agregar imagen" PreviewMouseLeftButtonDown="MenuAgregarImagen_PreviewMouseLeftButtonDown"/>
            <MenuItem x:Name="MenuAgregarVideo" Header="Agregar video/audio" PreviewMouseLeftButtonDown="MenuAgregarVideo_PreviewMouseLeftButtonDown"/>
            <MenuItem x:Name="MenuAgregarTabla" Header="Agregar tabla" PreviewMouseLeftButtonDown="MenuAgregarTabla_PreviewMouseLeftButtonDown"/>
            <MenuItem x:Name="MenuAgregarWEB" Header="Agregar web" PreviewMouseLeftButtonDown="MenuAgregarWEB_PreviewMouseLeftButtonDown"/>
            <MenuItem x:Name="MenuAgregarFecha" Header="Agregar fecha" PreviewMouseLeftButtonDown="MenuAgregarFecha_PreviewMouseLeftButtonDown"/>
            <MenuItem x:Name="MenuAgregarReloj" Header="Agregar reloj" PreviewMouseLeftButtonDown="MenuAgregarReloj_PreviewMouseLeftButtonDown"/>
            <MenuItem x:Name="MenuTurnos" Header="Turnos">
                <MenuItem x:Name="MenuMostrarOcultarTurnoAnt" Header="Agregar turnos anteriores" PreviewMouseLeftButtonDown="MenuMostrarOcultarTurnoAnt_PreviewMouseLeftButtonDown" />
                <MenuItem x:Name="MenuMostrarOcultarEquipoAnt" Header="Agregar equipos anteriores" PreviewMouseLeftButtonDown="MenuMostrarOcultarEquipoAnt_PreviewMouseLeftButtonDown" />
            </MenuItem>
            <Separator />
            <MenuItem x:Name="MenuListaObjetos" Header="Lista de objetos"/>
            <MenuItem x:Name="Propiedades" Header="Propiedades" PreviewMouseLeftButtonDown="Propiedades_PreviewMouseLeftButtonDown"/>
            <Separator />
            <MenuItem x:Name="MenuReiniciarDiseno" Header="Reiniciar diseño" PreviewMouseLeftButtonDown="MenuReiniciarDiseno_PreviewMouseLeftButtonDown"/>
            <MenuItem x:Name="MenuSalir" Header="Salir" PreviewMouseLeftButtonDown="MenuSalir_PreviewMouseLeftButtonDown"/>
        </ContextMenu>
        <ContextMenu x:Key="cmdContexMenu">
            <MenuItem x:Name="MenuTraerFrente" Header="Traer al frente" PreviewMouseLeftButtonDown="MenuTraerFrente_PreviewMouseLeftButtonDown" />
            <MenuItem x:Name="MenuPropiedades" Header="Propiedades" PreviewMouseLeftButtonDown="MenuPropiedades_PreviewMouseLeftButtonDown"/>
            <Separator />
            <MenuItem x:Name="MenuEliminar" Header="Eliminar" PreviewMouseLeftButtonDown="MenuEliminar_PreviewMouseLeftButtonDown"/>
        </ContextMenu>
    </Window.Resources>
    <Grid x:Name="Principal" PreviewMouseMove="Principal_PreviewMouseMove" PreviewMouseLeftButtonDown="Principal_PreviewMouseDown" PreviewMouseLeftButtonUp="Principal_PreviewMouseUp" MouseLeftButtonDown="Principal_MouseLeftButtonDown" Background="White">
        <Grid x:Name="Base" />
        <Image x:Name="Fondo" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill" />
        <Grid x:Name="VistaPrevia" Panel.ZIndex="1000"/>
        <Menu x:Name="Menu" Background="White" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="1000" Height="25">
            <MenuItem x:Name="Archivo" Header="Archivo" Background="#FFEAE8E8" FontFamily="Arial Rounded MT" Height="25">
                <MenuItem x:Name="Activar" Header="Activar" FontFamily="Arial Rounded MT" Click="Activar_Click"/>
                <Separator />
                <MenuItem x:Name="ImportarDiseno" Header="Importar diseño" Click="ImportarDiseno_Click" FontFamily="Arial Rounded MT"/>
                <MenuItem x:Name="ExportarDiseno" Header="Exportar diseño" Click="ExportarDiseno_Click" FontFamily="Arial Rounded MT"/>
                <Separator />
                <MenuItem x:Name="Salir" Header="Salir" Click="Salir_Click" FontFamily="Arial Rounded MT"/>
            </MenuItem>
            <MenuItem x:Name="Editar" Header="Editar" Background="#FFEAE8E8" FontFamily="Arial Rounded MT" Height="25">
                <MenuItem x:Name="EditarDiseno" Header="Editar diseño" Click="EditarDiseno_Click" FontFamily="Arial Rounded MT"/>
                <Separator />
                <MenuItem x:Name="EditarDisenoTurnero" Header="Editar diseño turnero" FontFamily="Arial Rounded MT" Click="EditarDisenoTurnero_Click"/>
                <MenuItem x:Name="EditarDisenoVerificador" Header="Editar diseño verificador de precios" FontFamily="Arial Rounded MT" Click="EditarDisenoVerificador_Click"/>
                <MenuItem x:Name="EditarDisenoCajero" Header="Editar diseño cajero automático" FontFamily="Arial Rounded MT" Click="EditarDisenoCajero_Click"/>
            </MenuItem>
            <MenuItem x:Name="Configuracion" Header="Configuración" Background="#FFEAE8E8" FontFamily="Arial Rounded MT" Height="25">
                <MenuItem x:Name="Conexion" Header="Configurar conexión" FontFamily="Arial Rounded MT" Click="ConfigurarConexion_Click"/>
                <Separator />
                <MenuItem x:Name="Turnero" Header="Configurar turnero" FontFamily="Arial Rounded MT" Click="Turnero_Click"/>
                <MenuItem x:Name="Verificador" Header="Configurar verificador de precios" FontFamily="Arial Rounded MT" Click="Verificador_Click"/>
                <MenuItem x:Name="Cajero" Header="Configurar cajero automático" FontFamily="Arial Rounded MT" Click="Cajero_Click"/>
            </MenuItem>
            <MenuItem x:Name="Ayuda" Header="Ayuda" Background="#FFEAE8E8" FontFamily="Arial Rounded MT" Height="25">
                <MenuItem x:Name="Sobre" Header="Sobre Priceio" FontFamily="Arial Rounded MT"/>
            </MenuItem>
        </Menu>
        <Label x:Name="Coordenadas" Content="Coordenadas: 1920X, 1080Y" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="14" Foreground="Red" FontFamily="Arial Rounded MT" Panel.ZIndex="1000"/>
        <Label x:Name="ModoEdicion" Grid.Column="0" Content="Vista previa" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="18" Foreground="Red" FontFamily="Arial Rounded MT" Panel.ZIndex="1000"/>
        <Grid x:Name="PantallaCompleta" Panel.ZIndex="1000"/>
        <Button x:Name="LogoPrincipal"  Height="60" Width="60" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.5" Panel.ZIndex="1000" BorderThickness="0,0,0,0" MouseDoubleClick="LogoPrincipal_MouseDoubleClick">
            <Button.Background>
                <ImageBrush ImageSource="/logo.png"/>
            </Button.Background>
        </Button>
    </Grid>
</Window>
