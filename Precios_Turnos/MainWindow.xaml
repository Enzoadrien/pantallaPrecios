<Window x:Class="Precios_Turnos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Precios_Turnos"
        mc:Ignorable="d"
        Title="Lista de precios y turnero 3K" Height="800" Width="1024" SizeChanged="Window_SizeChanged" KeyDown="Window_KeyDown" WindowStyle="ThreeDBorderWindow" WindowStartupLocation="CenterScreen" PreviewMouseDown="Window_PreviewMouseDown" PreviewMouseUp="Window_PreviewMouseUp" PreviewMouseMove="Window_PreviewMouseMove">
    <Grid x:Name="Principal">
        <Grid.RowDefinitions>
            <RowDefinition Height="60*"/>
            <RowDefinition Height="750*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Menu x:Name="Menu" Background="White">
            <MenuItem x:Name="Archivo" Header="Archivo" Background="#FFEAE8E8">
                <MenuItem x:Name="Activar" Header="Activar" />
                <MenuItem x:Name="ConfigurarConexion" Header="Configurar conexión" />
                <Separator />
                <MenuItem x:Name="Turnero" Header="Turnero"/>
                <MenuItem x:Name="EditarDiseno" Header="Editar diseño" Click="EditarDiseno_Click" />
                <Separator />
                <MenuItem x:Name="Salir" Header="Salir" Click="Salir_Click"/>
            </MenuItem>

        </Menu>

        <Label x:Name="Titulo1" Content="3K Mantenimiento Profecional" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Arial Rounded MT Bold" FontSize="12" Grid.Column="0" Grid.ColumnSpan="3"/>
        <Label x:Name="Titulo2" Content="Lista de precios" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Arial Rounded MT Bold" FontSize="36" Grid.Column="1" Grid.Row="1"/>
        <Label x:Name="Titulo3" Content="Turno" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Arial Rounded MT Bold" FontSize="36" Grid.Column="2" Grid.Row="1" Visibility="Hidden"/>
        <Image HorizontalAlignment="Left" Height="218" Margin="79,210,0,0" Grid.Row="1" VerticalAlignment="Top" Width="206" Source="/metin mapa.jpg"/>

    </Grid>
</Window>
