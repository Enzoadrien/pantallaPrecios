<Window x:Class="Precios_Turnos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Precios_Turnos"
        mc:Ignorable="d"
        Title="Lista de precios y turnero 3K" Height="600" Width="800" SizeChanged="Window_SizeChanged" KeyDown="Window_KeyDown" WindowStyle="ThreeDBorderWindow" WindowStartupLocation="CenterScreen" FontFamily="Arial Rounded MT">
    <Grid x:Name="Principal" PreviewMouseMove="Principal_PreviewMouseMove" PreviewMouseLeftButtonDown="Principal_PreviewMouseDown" PreviewMouseLeftButtonUp="Principal_PreviewMouseUp" MouseLeftButtonDown="Principal_MouseLeftButtonDown" >
        <Menu x:Name="Menu" Background="White">
            <MenuItem x:Name="Archivo" Header="Archivo" Background="#FFEAE8E8" FontFamily="Arial Rounded MT">
                <MenuItem x:Name="Activar" Header="Activar" FontFamily="Arial Rounded MT"/>
                <MenuItem x:Name="ConfigurarConexion" Header="Configurar conexión" FontFamily="Arial Rounded MT"/>
                <Separator />
                <MenuItem x:Name="Turnero" Header="Turnero" FontFamily="Arial Rounded MT"/>
                <MenuItem x:Name="EditarDiseno" Header="Editar diseño" Click="EditarDiseno_Click" FontFamily="Arial Rounded MT"/>
                <Separator />
                <MenuItem x:Name="Salir" Header="Salir" Click="Salir_Click" FontFamily="Arial Rounded MT"/>
            </MenuItem>

        </Menu>

        <Label x:Name="Titulo1" Content="3K Mantenimiento Profecional" FontFamily="Arial Rounded MT" FontSize="36" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Label x:Name="Titulo2" Content="Lista de precios" FontFamily="Arial Rounded MT" FontSize="24" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic"/>
        <Image x:Name="Imagen1" HorizontalAlignment="Left" Height="218" Margin="79,210,0,0" Grid.Row="1" VerticalAlignment="Top" Width="206" Source="/metin mapa.jpg"/>
        <Label x:Name="Coordenadas" Grid.Column="2" Content="Coordenadas: 1920X, 1080Y" HorizontalAlignment="Right" Grid.Row="1" VerticalAlignment="Bottom" FontSize="14" Foreground="Red" FontFamily="Arial Rounded MT"/>
        <Label x:Name="ModoEdicion" Grid.Column="0" Content="Vista previa" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Bottom" FontSize="18" Foreground="Red" FontFamily="Arial Rounded MT"/>
    </Grid>
</Window>
