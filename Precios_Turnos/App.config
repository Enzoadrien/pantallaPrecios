<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
	<appSettings>
		<!--Configuracion ODBC-->
		<add key="ODBC" value="" />
		<add key="UsuarioODBC" value="" />
		<add key="ContrasenaODBC" value="" />
		
		<!--Configuracion ventana Splash-->
		<add key="TipoSplash" value="T" />
		<add key="ActivarSplash" value="false" />
		<add key="Ancho" value="0" />
		<add key="Alto" value="0" />
		<add key="Audio" value="Silencio" />
		<add key="Duracion" value="5" />
		
		<!--Configuracion Turnero-->
		<add key="TipoTurnero" value="S" />
		<add key="ProtocoloTurnero" value="T" />
		<add key="TurnosAnteriores" value="3" />
		<add key="Clientes" value="" />
