		<add key="TipoVoz" value="" />
		<add key="MostrarNombres" value="false" />

		<!--Configuracion Cajero-->
		<add key="PuertoTCP" value="9101" />
		<add key="LogPago" value="false" />
		
		<!--Configuracion Payout-->
		<add key="COMNV22" value="COM1" />
		<add key="SSPNV22" value="0" />
		<add key="Chanel1" value="true" />
		<add key="Chanel2" value="true" />
		<add key="Chanel3" value="true" />
		<add key="Chanel4" value="true" />
		<add key="Chanel5" value="false" />
		<add key="Chanel6" value="false" />
		<add key="Chanel1Min" value="5" />
		<add key="Chanel2Min" value="5" />
		<add key="Chanel3Min" value="5" />
		<add key="Chanel4Min" value="5" />
		<add key="Chanel5Min" value="0" />
		<add key="Chanel6Min" value="0" />

		<!--Configuracion Hopper-->
		<add key="COMHopper" value="COM1" />
		<add key="SSPHopper" value="16" />
		<add key="Chanel1" value="true" />
		<add key="Chanel2" value="true" />
		<add key="Chanel3" value="true" />
		<add key="Chanel4" value="true" />
		<add key="Chanel1Min" value="10" />
		<add key="Chanel2Min" value="10" />
		<add key="Chanel3Min" value="10" />
		<add key="Chanel4Min" value="10" />
		
		
		<!--Configuracion Impresora-->
		<add key="Impresora" value="POS58"/>
		<add key="TipoLetraImpresora" value="Courier New"/>
		<add key="TamanoLetraImpresora" value="8"/>
