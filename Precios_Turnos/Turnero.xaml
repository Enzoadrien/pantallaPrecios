<Window x:Class="Precios_Turnos.Turnero"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Precios_Turnos"
        mc:Ignorable="d"
         Title="Configurar turnero" Background="#FFD2CBCB" Height="460" Width="300" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" KeyDown="Window_KeyDown" Loaded="Window_Loaded" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.DataContext>
        <local:ViewModelAudio/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="35*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Background="#FF989090" Grid.ColumnSpan="3">
            <Label x:Name="Titulo" Content="Configurar turnero"  VerticalAlignment="Top" FontFamily="Arial Rounded MT" HorizontalAlignment="Left" FontSize="18" FontWeight="Bold"/>
        </StackPanel>
        <Button x:Name="Salir" Content="X" HorizontalAlignment="Right"  VerticalAlignment="Top"  Click="Salir_Click" Grid.Column="2" FontFamily="Arial Rounded MT" HorizontalContentAlignment="Center" Width="24" Height="24" >
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#FF989090"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFC42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Label x:Name="lblTipo" Content="Tipo:" Grid.Row="1" FontFamily="Arial Rounded MT" FontSize="14"/>
        <ComboBox x:Name="cbxTipo" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" SelectedValuePath="Tag" Margin="0,0,5,0" SelectionChanged="cbxTipo_SelectionChanged">
            <ComboBoxItem Content="Servidor" Tag="S"/>
            <ComboBoxItem Content="Cliente" Tag="C"/>
        </ComboBox>
        <Label x:Name="lblProtocolo" Content="Protocolo:" Grid.Row="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <ComboBox x:Name="cbxProtocolo" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2"  SelectedValuePath="Tag" Margin="0,0,5,0">
            <ComboBoxItem Content="Teclado PC" Tag="T"/>
            <ComboBoxItem Content="API" Tag="A"/>
            <ComboBoxItem Content="Kretz" Tag="K"/>
        </ComboBox>
        <Label x:Name="lblPuerto" Content="Puerto:" Grid.Row="3" FontFamily="Arial Rounded MT" FontSize="14"/>
        <TextBox x:Name="Puerto" Grid.Row="3" Grid.ColumnSpan="2" Text="" Grid.Column="1"  VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" Margin="0,0,5,0"/>
        <Label x:Name="lblAudio" Content="Audio:" Grid.Row="4" FontFamily="Arial Rounded MT" FontSize="14"/>
        <ComboBox x:Name="cbxAudio" ItemsSource="{Binding CmbContentAudio}" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,5,0" SelectionChanged="cbxAudio_SelectionChanged"/>
        <Label x:Name="lblDurar" Content="Durar:" Grid.Row="5" FontFamily="Arial Rounded MT" FontSize="14"/>
        <TextBox x:Name="Durar" Grid.Row="5" Text="" Grid.Column="1"  VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown" />
        <Label x:Name="lblSeg" Content="s" Grid.Row="5" Grid.Column="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <Label x:Name="lblTurnosAnt" Content="Turnos anteriores:" Grid.Row="6" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <ComboBox x:Name="cbxTurnosAnt" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="6" SelectedValuePath="Tag" Margin="35,0,5,0">
            <ComboBoxItem Content="1" Tag="1"/>
            <ComboBoxItem Content="2" Tag="2"/>
            <ComboBoxItem Content="3" Tag="3"/>
            <ComboBoxItem Content="4" Tag="4"/>
            <ComboBoxItem Content="5" Tag="5"/>
            <ComboBoxItem Content="6" Tag="6"/>
            <ComboBoxItem Content="7" Tag="7"/>
            <ComboBoxItem Content="8" Tag="8"/>
            <ComboBoxItem Content="9" Tag="9"/>
            <ComboBoxItem Content="10" Tag="10"/>
        </ComboBox>
        <Label x:Name="lblIP" Content="IP base:" Grid.Row="7" FontFamily="Arial Rounded MT" FontSize="14"/>
        <TextBox x:Name="IP" Grid.Row="7" Text="" Grid.Column="1" Grid.ColumnSpan="2" VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" Margin="0,0,5,0" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown" />
        <StackPanel Grid.Row="8"
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Margin="5,5,0,5" Grid.ColumnSpan="2" >
            <Button x:Name="btnBuscar"
              Content="Buscar turneros"
              IsDefault="True"
              Width="120"
              Height="20"
              Margin="0,0,0,0"
              TabIndex="0"
              FontFamily="Arial Rounded MT" 
              FontSize="14" Click="btnBuscar_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE47C25"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <ComboBox x:Name="cbxTurneros" Grid.Column="1"  Grid.Row="8" Grid.ColumnSpan="2" Margin="30,0,5,0"/>
        <Grid x:Name="gridBar" Grid.ColumnSpan="3" Grid.Row="9" Margin="5,5,5,5" >
            <ProgressBar x:Name="BarraP" Maximum="255" />
            <TextBlock x:Name="Progress" HorizontalAlignment="Center" VerticalAlignment="Center">0/255</TextBlock>
        </Grid>
        <Label x:Name="lblEncontrados" Content="Encontrados: 0" Grid.Row="10" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <CheckBox x:Name="chkVoz" Content="Voz de Windows" Grid.Row="11" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Margin="5,0,0,0" Checked="chkVoz_Checked" Unchecked="chkVoz_Unchecked"/>
        <StackPanel Grid.Row="11"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Margin="0,5,5,5" Grid.Column="1" Grid.ColumnSpan="2">
            <Button x:Name="btnVoz"
              Content="Configurar voz"
              IsDefault="True"
              Width="120"
              Height="20"
              Margin="0,0,0,0"
              TabIndex="0"
              FontFamily="Arial Rounded MT" 
              FontSize="14" Click="btnVoz_Click" Visibility="Hidden">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF0E596D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="12"
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Margin="5,5,0,5" Grid.ColumnSpan="2" >
            <Button x:Name="btnNombresEquipos"
              Content="Nombrar equipos"
              IsDefault="True"
              Width="120"
              Height="20"
              Margin="0,0,0,0"
              TabIndex="0"
              FontFamily="Arial Rounded MT" 
              FontSize="14" Click="btnNombresEquipos_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE47C25"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <CheckBox x:Name="chkMostrarNombres" Content="Mostrar nombres" Grid.Column="1" Grid.Row="12" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
        <CheckBox x:Name="chkTurnero" Content="Activar turnero" Grid.Column="1" Grid.Row="13" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
        <StackPanel Grid.Row="14"
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Margin="5,5,0,5" Grid.ColumnSpan="2" />
        <StackPanel Grid.Row="14"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Margin="0,5,5,5" Grid.Column="2" >
            <Button x:Name="btnOK"
              Content="Aceptar"
              IsDefault="True"
              Width="60"
              Height="20"
              Margin="0,0,0,0"
              TabIndex="0"
              FontFamily="Arial Rounded MT" 
              FontSize="14" Click="btnOK_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1E6D0E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
