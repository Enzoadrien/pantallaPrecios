<Window x:Class="Precios_Turnos.EditarDiseno"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Precios_Turnos"
        mc:Ignorable="d"
        Title="Editar diseño" Height="600" Width="300" WindowStyle="None" Opacity="0.8" Background="#FFD2CBCB" ShowInTaskbar="False" MouseLeftButtonDown="Window_MouseLeftButtonDown" AllowsTransparency="True" Topmost="True" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="600*"/>
        </Grid.RowDefinitions>
        <Button x:Name="Salir" Content="X" HorizontalAlignment="Right" Height="27" VerticalAlignment="Top" Width="30" Click="Salir_Click">
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#FFD2CBCB"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFC42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>

</Window>
