<Window x:Class="Precios_Turnos.MostrarTurno"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Precios_Turnos"
        mc:Ignorable="d"
        Title="Mostrar turno" Height="800" Width="600" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" MouseRightButtonUp="Principal_MouseRightButtonUp" Loaded="Window_Loaded" KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Window.Resources>
        <ContextMenu x:Key="cmdPrincipalContexMenu">
            <MenuItem x:Name="MenuAgregarTexto" Header="Agregar texto" PreviewMouseLeftButtonDown="MenuAgregarTexto_PreviewMouseLeftButtonDown"/>
            <MenuItem x:Name="MenuAgregarImagen" Header="Agregar imagen" PreviewMouseLeftButtonDown="MenuAgregarImagen_PreviewMouseLeftButtonDown"/>
            <MenuItem x:Name="MenuMostrarOcultarTurno" Header="Mostrar/ocultar turno" PreviewMouseLeftButtonDown="MenuMostrarOcultarTurno_PreviewMouseLeftButtonDown" />
            <MenuItem x:Name="MenuMostrarOcultarEquipo" Header="Mostrar/ocultar equipo" PreviewMouseLeftButtonDown="MenuMostrarOcultarEquipo_PreviewMouseLeftButtonDown" />
            <MenuItem x:Name="MenuMostrarOcultarNombreEquipo" Header="Mostrar/ocultar nombre equipo" PreviewMouseLeftButtonDown="MenuMostrarOcultarNombreEquipo_PreviewMouseLeftButtonDown" />
            <MenuItem x:Name="MenuMostrarOcultarTurnoAnt" Header="Mostrar/ocultar turno anterior" PreviewMouseLeftButtonDown="MenuMostrarOcultarTurnoAnt_PreviewMouseLeftButtonDown" />
            <MenuItem x:Name="MenuMostrarOcultarEquipoAnt" Header="Mostrar/ocultar equipo anterior" PreviewMouseLeftButtonDown="MenuMostrarOcultarEquipoAnt_PreviewMouseLeftButtonDown" />
            <MenuItem x:Name="MenuMostrarOcultarNombreEquipoAnt" Header="Mostrar/ocultar nombre equipo anterior" PreviewMouseLeftButtonDown="MenuMostrarOcultarNombreEquipoAnt_PreviewMouseLeftButtonDown" />
            <Separator />
            <MenuItem x:Name="MenuListaObjetos" Header="Lista de objetos"/>
            <MenuItem x:Name="Propiedades" Header="Propiedades" PreviewMouseLeftButtonDown="Propiedades_PreviewMouseLeftButtonDown"/>
            <Separator />
            <MenuItem x:Name="MenuSalir" Header="Salir" PreviewMouseLeftButtonDown="MenuSalir_PreviewMouseLeftButtonDown"/>
        </ContextMenu>
        <ContextMenu x:Key="cmdContexMenu">
            <MenuItem x:Name="MenuTraerFrente" Header="Traer al frente" PreviewMouseLeftButtonDown="MenuTraerFrente_PreviewMouseLeftButtonDown" />
            <MenuItem x:Name="MenuPropiedades" Header="Propiedades" PreviewMouseLeftButtonDown="MenuPropiedades_PreviewMouseLeftButtonDown"/>
            <Separator />
            <MenuItem x:Name="MenuEliminar" Header="Eliminar" PreviewMouseLeftButtonDown="MenuEliminar_PreviewMouseLeftButtonDown"/>
        </ContextMenu>
    </Window.Resources>
    <Grid x:Name="Principal" PreviewMouseMove="Principal_PreviewMouseMove" PreviewMouseLeftButtonDown="Principal_PreviewMouseDown" PreviewMouseLeftButtonUp="Principal_PreviewMouseUp" MouseLeftButtonDown="Principal_MouseLeftButtonDown" Background="White">
        <Grid x:Name="Fondo"></Grid>
        <Border x:Name="Borde" BorderBrush="Black" BorderThickness="3"/>
        <Label x:Name="NumeroTurno" Content="Num. turno" FontSize="36" FontFamily="Arial" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="NumeroEquipo" Content="Num. equipo" FontSize="36" FontFamily="Arial" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="NombreEquipo" Content="Nom. equipo" FontSize="36" FontFamily="Arial" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="NumeroTurnoAnt" Content="Num. turno anterior" FontSize="36" FontFamily="Arial" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="NumeroEquipoAnt" Content="Num. equipo anterior" FontSize="36" FontFamily="Arial" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="NombreEquipoAnt" Content="Nom. equipo anterior" FontSize="36" FontFamily="Arial" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Label x:Name="ModoEdicion" Content="Modo edición" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="18" Foreground="Red" FontFamily="Arial Rounded MT" Panel.ZIndex="1000"/>
        <Label x:Name="Coordenadas" Content="Coordenadas: 1920X, 1080Y" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="14" Foreground="Red" FontFamily="Arial Rounded MT" Panel.ZIndex="1000" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
