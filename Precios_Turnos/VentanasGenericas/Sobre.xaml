<Window x:Class="Priceio.Sobre"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Priceio"
        mc:Ignorable="d"
        Title="Sobre"  Background="#FFD2CBCB" WindowStyle="None" Height="290" Width="300" ResizeMode="NoResize" KeyDown="Window_KeyDown" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="80*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="90*"/>
            <RowDefinition Height="90*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal"
        Background="#FF989090" Grid.ColumnSpan="2">
            <Label x:Name="lblNombre" Content="Sobre"  VerticalAlignment="Top" FontFamily="Arial Rounded MT" Grid.ColumnSpan="2" HorizontalAlignment="Left" FontSize="18" FontWeight="Bold"/>
        </StackPanel>
        <Button x:Name="Salir" Content="X" HorizontalAlignment="Right"  VerticalAlignment="Top" Grid.Column="1" Click="Salir_Click" FontFamily="Arial Rounded MT" HorizontalContentAlignment="Center" Width="24" Height="24" >
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#FF989090"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFC42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Label Grid.Row="1" Content ="Priceio by 3K" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
        <Image Grid.Row="2" Source="/logo.png" Margin="10,10,10,10"/>
        <Image Grid.Row="3" Source="/logoPriceio.png" Margin="10,10,10,10"/>
        <TextBlock Text="Advertencia: Priceio y 3K son marcas registradas, este programa está protegido por las leyes de derechos de autor y otros tratados internacionales. La reproducción o distribución ilícitas de este programa, o de cualquier parte del mismo está penada por la ley con severas sanciones civiles y penales, y será objeto de todas las acciones judiciales que correspondan en derecho." FontFamily="Arial Rounded MT" Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Label x:Name="Version" Grid.Row="4" Content ="Version" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
