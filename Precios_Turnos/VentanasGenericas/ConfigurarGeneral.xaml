<Window x:Class="Priceio.VentanasGenericas.ConfigurarGeneral"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Priceio.VentanasGenericas"
        mc:Ignorable="d"
         Title="Configuración general" Background="#FFD2CBCB" Height="180" Width="300" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" KeyDown="Window_KeyDown" MouseLeftButtonDown="Window_MouseLeftButtonDown" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="35*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                 Background="#FF989090" Grid.ColumnSpan="3">
            <Label x:Name="Titulo" Content="Configuración general" VerticalAlignment="Top" FontFamily="Arial Rounded MT" HorizontalAlignment="Left" FontSize="18" FontWeight="Bold"/>
        </StackPanel>
        <Button x:Name="Salir" Content="X" HorizontalAlignment="Right"  VerticalAlignment="Top"  Click="Salir_Click" Grid.Column="2" FontFamily="Arial Rounded MT" HorizontalContentAlignment="Center" Width="24" Height="24" >
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#FF989090"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFC42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Label x:Name="lblMensajes" Content="Mensajes" Grid.Row="1" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="1"/>
        <Label x:Name="lblTamano" Content="Tamaño:" Grid.Row="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <ComboBox x:Name="cbxTamano" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,5,0" SelectedValuePath="Tag" SelectedIndex="0">
            <ComboBoxItem Content="Extra grande" Tag="E"/>
            <ComboBoxItem Content="Grande" Tag="G"/>
            <ComboBoxItem Content="Normal" Tag="N"/>
        </ComboBox>
        <CheckBox x:Name="chkCierreAutomatico" Content="Cierre automático" Grid.Row="3" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Grid.Column="1" Checked="chkCierreAutomatico_Checked" Unchecked="chkCierreAutomatico_Unchecked"/>
        <Label x:Name="lblDuracion" Content="Duración:" Grid.Row="4" FontFamily="Arial Rounded MT" FontSize="14"/>
        <TextBox x:Name="Duracion" VerticalContentAlignment="Center" Grid.Row="4" Grid.Column="1" FontFamily="Arial Rounded MT" FontSize="14" Margin="0,0,5,0" Text="5" IsEnabled="False"/>
        <Label x:Name="lblSeg" Content="seg" Grid.Row="4" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="2"/>
        <StackPanel Grid.Row="5"
             HorizontalAlignment="Right"
             Orientation="Horizontal"
             Margin="0,5,5,5" Grid.Column="2" >
            <Button x:Name="btnOK"
           Content="Aceptar"
           Click="btnOK_Click"
           IsDefault="True"
           Width="60"
           Height="20"
           Margin="0,0,0,0"
           TabIndex="0"
           FontFamily="Arial Rounded MT" 
           FontSize="14">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1E6D0E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
