<Window x:Class="Precios_Turnos.ColorPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="330" Width="480" WindowStyle="None" KeyDown="Window_KeyDown" ResizeMode="NoResize">
    <Window.Resources>
        <DrawingBrush x:Key="CheckerboardBrush"
        Stretch="None" TileMode="Tile" AlignmentX="Left" AlignmentY="Top"
        Viewport="0,0,10,10" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="sc# 1,1,1">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,10,10" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="sc# 0.5,0.5,0.5">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,5,5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="sc# 0.5,0.5,0.5">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="5,5,5,5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid Background="#FFD2CBCB" MouseWheel="AlphaSlider_MouseWheel" MouseUp="CanvasImage_MouseUp" Height="330" Width="480">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="71*"/>
            <ColumnDefinition Width="169*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="6*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Background="#FF989090" Grid.ColumnSpan="2"  MouseLeftButtonDown="StackPanel_MouseLeftButtonDown">
            <Label Content="Selecciona la muestra" Foreground="Black" FontFamily="Arial Rounded MT" 
              FontSize="18" VerticalAlignment="Center"/>
            <Image x:Name="ImgSqaure1" Height="20" Width="20"
                   Source="/ColorSwatchSquare1.png" Margin="45,0,0,0"
                   ToolTip="Color Swatch Square 1"
                   MouseLeftButtonDown="Swatch_MouseLeftButtonDown"/>
            <Image x:Name="ImgSqaure2" Height="20" Width="20"
                   Source="/ColorSwatchSquare2.png" Margin="5,0,0,0"
                   ToolTip="Color Swatch Square 2"
                   MouseLeftButtonDown="Swatch_MouseLeftButtonDown"/>
            <Image x:Name="ImgCircle1" Height="20" Width="20"
                   Source="/ColorSwatchCircle.png" Margin="5,0,0,0"
                   ToolTip="Color Swatch Circle"
                   MouseLeftButtonDown="Swatch_MouseLeftButtonDown"/>
        </StackPanel>
        <Button x:Name="Salir" Content="X" Click="Salir_Click" FontFamily="Arial Rounded MT" HorizontalContentAlignment="Center" Width="24" Height="24" VerticalAlignment="Top" HorizontalAlignment="Right" Grid.ColumnSpan="2">
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#FF989090"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFC42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Grid x:Name="MainGrid"
          Grid.Row="1" MouseDown="CanvasImage_MouseDown"
          MouseUp="CanvasImage_MouseUp" Margin="0,0,0,34" Grid.RowSpan="2" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="164"/>
                <ColumnDefinition Width="176"/>
            </Grid.ColumnDefinitions>

            <!-- Colorbox, Column1-->
            <Grid Grid.Column="0" Grid.Row="0" Margin="10,30,0,0" >

                <Border BorderBrush="Black"
                BorderThickness="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="White"
                Width="154"
                Height="154"/>
                <!-- Selection, Column 0-->
                <Image x:Name="ColorImage"
                 Width="150"
                 Height="150"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="2"
                 Source="/ColorSwatchSquare1.png"/>
                <Canvas x:Name="canvasImage"
                Width="150"
                Height="150"
                HorizontalAlignment="Center"
                Background="Transparent"
                VerticalAlignment="Top"
                Margin="2"
                MouseDown="CanvasImage_MouseDown"
                MouseUp="CanvasImage_MouseUp"
                MouseMove="CanvasImage_MouseMove">
                    <Ellipse x:Name="ellipsePixel"
                   Width="8"
                   Height="8"
                   Stroke="Black"
                   Fill="White"
                   Canvas.Left="0"
                   Canvas.Top="0"/>
                </Canvas>
            </Grid>

            <!-- Preview, Column 1-->
            <StackPanel Grid.Column="1" Orientation="Vertical" Grid.ColumnSpan="2" Margin="0,0,169,0" MouseDown="CanvasImage_MouseDown" MouseUp="CanvasImage_MouseUp">
                <Label Content="Vista previa" Margin="5,0,0,0" HorizontalAlignment="Left"
                       Foreground="Black" FontFamily="Arial Rounded MT" FontSize="14" VerticalAlignment="Center"/>

                <Border Margin="4,5,10,0" Width="154" Height="154"
                        HorizontalAlignment="Left" BorderBrush="Black" BorderThickness="2"
                        Background="{StaticResource CheckerboardBrush}">
                    <InkPresenter x:Name="previewPresenter"
                                  Margin="0"
                                  Width="150"
                                  Height="150"
                                  MouseDown="CanvasImage_MouseDown"
                                  MouseUp="CanvasImage_MouseUp"
                                  Strokes="" />
                </Border>
            </StackPanel>

            <!-- TextBoxes, Column 2-->
            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,28,0">

                <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                    <Label Content="A" Margin="5,0,0,0" HorizontalAlignment="Left"
                            Foreground="Black" FontFamily="Arial Rounded MT" FontSize="14" VerticalAlignment="Center"/>
                    <Border CornerRadius="5" BorderBrush="Black" Background="White"
                            BorderThickness="2" Width="50" Height="30">
                        <TextBox x:Name="txtAlpha" BorderThickness="0" Background="White"
                            BorderBrush="Transparent" Margin="5,1,5,1" TextAlignment="Center" Padding="0,5,0,0" IsTabStop="False" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown" PreviewKeyUp="txtAlpha_PreviewKeyUp"/>
                    </Border>
                    <Border CornerRadius="5" BorderBrush="Black" Background="White"
                            BorderThickness="2" Margin="10,0,0,0" Width="50" Height="30">
                        <TextBox x:Name="txtAlphaHex" BorderThickness="0"
                            Background="White" BorderBrush="Transparent"
                            Margin="5,1,5,1" IsReadOnly="True" TextAlignment="Center" Padding="0,5,0,0" IsTabStop="False"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Label Content="R" Margin="5,0,0,0" HorizontalAlignment="Left"
                            Foreground="Black" FontFamily="Arial Rounded MT" FontSize="14" VerticalAlignment="Center"/>
                    <Border CornerRadius="5" BorderBrush="Black" Background="White"
                            BorderThickness="2" Width="50" Height="30">
                        <TextBox x:Name="txtRed" BorderThickness="0" Background="White"
                            BorderBrush="Transparent" Margin="5,1,5,1" TextAlignment="Center" Padding="0,5,0,0" IsTabStop="False" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown" PreviewKeyUp="txtAlpha_PreviewKeyUp"/>
                    </Border>
                    <Border CornerRadius="5" BorderBrush="Black" Background="White"
                            BorderThickness="2" Margin="10,0,0,0" Width="50" Height="30">
                        <TextBox x:Name="txtRedHex" BorderThickness="0" Background="White"
                            BorderBrush="Transparent"  IsReadOnly="True" Margin="5,1,5,1" TextAlignment="Center" Padding="0,5,0,0" IsTabStop="False"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Label Content="G" Margin="5,0,0,0" HorizontalAlignment="Left"
                            FontFamily="Arial Rounded MT" FontSize="14" FontWeight="Bold"
                            VerticalAlignment="Center"/>
                    <Border CornerRadius="5" BorderBrush="Black" Background="White"
                            BorderThickness="2" Width="50" Height="30">
                        <TextBox x:Name="txtGreen" BorderThickness="0"
                            Background="White" BorderBrush="Transparent"
                            Margin="5,1,5,1" TextAlignment="Center" Padding="0,5,0,0" IsTabStop="False" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown" PreviewKeyUp="txtAlpha_PreviewKeyUp"/>
                    </Border>
                    <Border CornerRadius="5" BorderBrush="Black" Background="White"
                            BorderThickness="2" Margin="10,0,0,0" Width="50" Height="30">
                        <TextBox x:Name="txtGreenHex" BorderThickness="0"
                            Background="White" BorderBrush="Transparent"
                            Margin="5,1,5,1" IsReadOnly="True" TextAlignment="Center" Padding="0,5,0,0" IsTabStop="False"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Label Content="B" Margin="5,0,0,0" HorizontalAlignment="Left"
                           Foreground="Black" FontFamily="Arial Rounded MT" FontSize="14"
                           VerticalAlignment="Center"/>
                    <Border CornerRadius="5" BorderBrush="Black" Background="White"
                           BorderThickness="2" Width="50" Height="30">
                        <TextBox x:Name="txtBlue" BorderThickness="0" Background="White"
                           BorderBrush="Transparent" Margin="5,1,5,1"  TextAlignment="Center" Padding="0,5,0,0" IsTabStop="False" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown" PreviewKeyUp="txtAlpha_PreviewKeyUp" LostFocus="txtBlue_LostFocus"/>
                    </Border>
                    <Border CornerRadius="5" BorderBrush="Black" Background="White"
                            BorderThickness="2" Margin="10,0,0,0" Width="50" Height="30">
                        <TextBox x:Name="txtBlueHex" BorderThickness="0"
                            Background="White" BorderBrush="Transparent"
                            Margin="5,1,5,1" IsReadOnly="True" TextAlignment="Center" Padding="0,5,0,0" IsTabStop="False"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Border CornerRadius="5" Margin="22,0,0,0" Background="White"
                            BorderBrush="Black" BorderThickness="2" Width="112" Height="30">
                        <TextBox x:Name="txtAll" BorderThickness="0" Background="White"
                            BorderBrush="Transparent" Margin="5,1,5,1" IsReadOnly="True" TextAlignment="Center" Padding="0,5,0,0" IsTabStop="False"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--AlphaSlider-->
        <Border x:Name="AlphaBorder"
                Grid.Row="2"
                Grid.ColumnSpan="2"
                BorderBrush="Black"
                Height="40"
                BorderThickness="2"
                CornerRadius="5"
                MouseWheel="AlphaSlider_MouseWheel"
                Margin="10,12,10,12">
            <Slider x:Name="AlphaSlider"
                    Orientation="Horizontal"
                    Minimum="0"
                    Maximum="255"
                    SmallChange="1"
                    LargeChange="25"
                    VerticalAlignment="Center"
                    Margin="5"
                    Value="255"
                    ValueChanged="AlphaSlider_ValueChanged"/>
        </Border>

        <Border x:Name="ultimoColorLetra" Margin="15,0,10,0" Grid.Row="3" Width="20" Height="20"
                        HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="Black" BorderThickness="2"
                        Background="{StaticResource CheckerboardBrush}" MouseLeftButtonDown="ultimoColorLetra_MouseLeftButtonDown">
        </Border>
        
        <Border x:Name="ultimoColorFondo" Margin="40,0,10,0" Grid.Row="3" Width="20" Height="20"
                        HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="Black" BorderThickness="2"
                        Background="{StaticResource CheckerboardBrush}" MouseLeftButtonDown="ultimoColorLetra_MouseLeftButtonDown">
        </Border>

        <StackPanel Grid.Row="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Margin="183,5,5,5" Grid.Column="1" >
            <Button x:Name="btnOK"
              Content="Aceptar"
              Click="btnOK_Click"
              IsDefault="True"
              Width="60"
              Height="20"
              Margin="10,0,0,0"
              TabIndex="0"
              FontFamily="Arial Rounded MT" 
              FontSize="14">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1E6D0E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>