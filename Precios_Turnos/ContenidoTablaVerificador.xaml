<Window x:Class="Precios_Turnos.ContenidoTablaVerificador"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Precios_Turnos"
        mc:Ignorable="d"
        Title="Contenido consulta SQL" Background="#FFD2CBCB" Opacity="0.9" Height="220" Width="600" WindowStyle="None" KeyDown="Window_KeyDown" AllowsTransparency="True" ResizeMode="NoResize" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="35*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Background="#FF989090" Grid.ColumnSpan="3">
            <Label x:Name="Titulo" Content="Contenido consulta SQL"  VerticalAlignment="Top" FontFamily="Arial Rounded MT" HorizontalAlignment="Left" FontSize="18" FontWeight="Bold"/>
        </StackPanel>
        <Button x:Name="Salir" Content="X" HorizontalAlignment="Right"  VerticalAlignment="Top"  Click="Salir_Click" Grid.Column="2" FontFamily="Arial Rounded MT" HorizontalContentAlignment="Center" Width="24" Height="24" >
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#FF989090"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFC42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Label x:Name="lblConsulta" Content="Consulta:" Grid.Row="1" FontFamily="Arial Rounded MT" FontSize="14"/>
        <ScrollViewer Grid.Row="2" Grid.RowSpan="2" Grid.ColumnSpan="3" VerticalScrollBarVisibility="Auto" Margin="5,0,5,0">
            <TextBox x:Name="Consulta"  FontFamily="Arial Rounded MT" FontSize="14" Background="White" TextWrapping="Wrap"/>
        </ScrollViewer>
        <Label x:Name="lblTipoDato" Content="Tipo de dato:" Grid.Row="4" FontFamily="Arial Rounded MT" FontSize="14"  />
        <ComboBox x:Name="cbxTipoCampo"
                  FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="1" Grid.Row="4" SelectedValuePath="Tag" SelectedIndex="0" >
            <ComboBoxItem Content="Numérico" Tag="N"/>
            <ComboBoxItem Content="Texto" Tag="T"/>
        </ComboBox>
        <Label x:Name="lblDatoPrueba" Content="Dato para prueba:" Grid.Row="5" FontFamily="Arial Rounded MT" FontSize="14"  />
        <TextBox x:Name="DatoPrueba" Grid.Row="5" Text="" Grid.Column="1" VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown" />
        <CheckBox x:Name="chkImagen" Content="Mostrar imagen" Grid.Row="4" Grid.Column="2" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0" Checked="chkImagen_Checked" Unchecked="chkImagen_Unchecked"/>
        <Label Content="Se debe remplazar el campo a buscar por la palabra reservada DatoBuscar_" Grid.Row="6" FontFamily="Arial Rounded MT" FontSize="10" Grid.ColumnSpan="2"  />
        <Label Content="Ejemplo: SELECT * FROM ARTICULOS WHERE ID=DatoBuscar_" Grid.Row="6" FontFamily="Arial Rounded MT" FontSize="10" Grid.ColumnSpan="2" VerticalAlignment="Bottom"  />
        <StackPanel Grid.Row="5"
        HorizontalAlignment="Right"
        Orientation="Horizontal"
        Margin="5,5,5,5" Grid.Column="2" >
            <Button x:Name="btnAbrir"
      Content="Abrir carpeta imagenes"
      IsDefault="True"
      Width="170"
      Height="20"
      Margin="0,0,0,0"
      TabIndex="4"
      FontFamily="Arial Rounded MT" 
      FontSize="14" Click="btnAbrir_Click" Visibility="Hidden">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF0E596D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="45"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Margin="0,5,5,5" Grid.Column="2" >
            <Button x:Name="btnProbar"
              Content="Cargar vista previa"
              IsDefault="True"
              Width="150"
              Height="20"
              Margin="0,0,0,0"
              TabIndex="0"
              FontFamily="Arial Rounded MT" 
              FontSize="14" Click="btnProbar_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1E6D0E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
