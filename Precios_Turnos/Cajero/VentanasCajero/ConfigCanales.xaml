<Window x:Class="Priceio.ConfigCanales"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Priceio"
        mc:Ignorable="d"
        Title="Titulo" Background="#FFD2CBCB" WindowStyle="None" Height="370" Width="400" ResizeMode="NoResize" KeyDown="Window_KeyDown" MouseLeftButtonDown="Window_MouseLeftButtonDown" Closing="Window_Closing" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="35*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal"
        Background="#FF989090" Grid.ColumnSpan="4">
            <Label x:Name="Titulo" Content="Configurar..."  VerticalAlignment="Top" FontFamily="Arial Rounded MT" Grid.ColumnSpan="2" HorizontalAlignment="Left" FontSize="18" FontWeight="Bold"/>
        </StackPanel>
        <Button x:Name="Salir" Content="X" HorizontalAlignment="Right"  VerticalAlignment="Top" Grid.Column="4" Click="Salir_Click" FontFamily="Arial Rounded MT" HorizontalContentAlignment="Center" Width="24" Height="24" >
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#FF989090"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFC42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Label x:Name="lblNiveles" Content="Niveles:" Grid.ColumnSpan="2" Grid.Row="1" FontFamily="Arial Rounded MT" FontSize="14"/>
        <ListBox x:Name="Niveles" Grid.Row="2" Grid.RowSpan="6" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" Margin="5,0,0,0" IsEnabled="False">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Height" Value="29" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBoxItem Content="20.00 MXN [0] = 0 MXN"/>
            <ListBoxItem Content="50.00 MXN [0] = 0 MXN"/>
            <ListBoxItem Content="100.00 MXN [0] = 0 MXN"/>
            <ListBoxItem Content="200.00 MXN [0] = 0 MXN"/>
            <ListBoxItem Content="500.00 MXN [0] = 0 MXN"/>
            <ListBoxItem Content="1000.00 MXN [0] = 0 MXN"/>
        </ListBox>
        <Label x:Name="lblMinimos" Content="Mínimos"  Grid.Row="1" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="2" HorizontalAlignment="Center"/>
        <TextBox x:Name="Ch1Min" Grid.Row="2" Grid.Column="2" Margin="5,0,5,0" FontFamily="Arial Rounded MT" FontSize="14"/>
        <TextBox x:Name="Ch2Min" Grid.Row="3" Grid.Column="2" Margin="5,0,5,0" FontFamily="Arial Rounded MT" FontSize="14"/>
        <TextBox x:Name="Ch3Min" Grid.Row="4" Grid.Column="2" Margin="5,0,5,0" FontFamily="Arial Rounded MT" FontSize="14"/>
        <TextBox x:Name="Ch4Min" Grid.Row="5" Grid.Column="2" Margin="5,0,5,0" FontFamily="Arial Rounded MT" FontSize="14"/>
        <TextBox x:Name="Ch5Min" Grid.Row="6" Grid.Column="2" Margin="5,0,5,0" FontFamily="Arial Rounded MT" FontSize="14"/>
        <TextBox x:Name="Ch6Min" Grid.Row="7" Grid.Column="2" Margin="5,0,5,0" FontFamily="Arial Rounded MT" FontSize="14"/>
        <Label x:Name="lblActivo" Content="Activo"  Grid.Row="1" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="3" HorizontalAlignment="Center"/>
        <CheckBox x:Name="chkCh1" Tag="1" Content="Ch1" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Center" FontFamily="Arial Rounded MT" FontSize="14" VerticalAlignment="Center" Checked="chkCh_Checked" Unchecked="chkCh_Unchecked"/>
        <CheckBox x:Name="chkCh2" Tag="2" Content="Ch2" Grid.Row="3" Grid.Column="3" HorizontalAlignment="Center" FontFamily="Arial Rounded MT" FontSize="14" VerticalAlignment="Center" Checked="chkCh_Checked" Unchecked="chkCh_Unchecked"/>
        <CheckBox x:Name="chkCh3" Tag="3" Content="Ch3" Grid.Row="4" Grid.Column="3" HorizontalAlignment="Center" FontFamily="Arial Rounded MT" FontSize="14" VerticalAlignment="Center" Checked="chkCh_Checked" Unchecked="chkCh_Unchecked"/>
        <CheckBox x:Name="chkCh4" Tag="4" Content="Ch4" Grid.Row="5" Grid.Column="3" HorizontalAlignment="Center" FontFamily="Arial Rounded MT" FontSize="14" VerticalAlignment="Center" Checked="chkCh_Checked" Unchecked="chkCh_Unchecked"/>
        <CheckBox x:Name="chkCh5" Tag="5" Content="Ch5" Grid.Row="6" Grid.Column="3" HorizontalAlignment="Center" FontFamily="Arial Rounded MT" FontSize="14" VerticalAlignment="Center" Checked="chkCh_Checked" Unchecked="chkCh_Unchecked"/>
        <CheckBox x:Name="chkCh6" Tag="6" Content="Ch6" Grid.Row="7" Grid.Column="3" HorizontalAlignment="Center" FontFamily="Arial Rounded MT" FontSize="14" VerticalAlignment="Center" Checked="chkCh_Checked" Unchecked="chkCh_Unchecked"/>
        <Label x:Name="lblPagoMinimo" Content="Pago mínimo:" Grid.Row="8" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Left" Grid.ColumnSpan="2"/>
        <TextBox x:Name="PagoMinimo" Grid.Row="8" Grid.Column="1" Margin="5,0,5,0" FontFamily="Arial Rounded MT" FontSize="14"/>
        <Label x:Name="lblPagoMaximo" Content="Pago máximo:" Grid.Row="8" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Left" Grid.Column="2" Grid.ColumnSpan="2"/>
        <TextBox x:Name="PagoMaximo" Grid.Row="8" Grid.Column="3" Margin="5,0,5,0" FontFamily="Arial Rounded MT" FontSize="14"/>
        <StackPanel Grid.Row="10"
           HorizontalAlignment="Right"
           Orientation="Horizontal"
           Margin="5,5,0,5">
            <Button x:Name="btnRecargar"
         Content="Recargar"
         IsDefault="True"
         Width="80"
         Height="20"
         Margin="0,0,0,0"
         TabIndex="4"
         FontFamily="Arial Rounded MT" 
         FontSize="14" Click="btnRecargar_Click" HorizontalAlignment="Right">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF0E596D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
       
        <TextBox x:Name="Retiro" Grid.Row="10" Grid.Column="2" Margin="5,0,5,0" FontFamily="Arial Rounded MT" FontSize="14"/>
        <StackPanel Grid.Row="10"
  HorizontalAlignment="Right"
  Orientation="Horizontal"
  Margin="5,5,0,5" Grid.Column="1" >
            <Button x:Name="btnRetirar"
Content="Retirar"
IsDefault="True"
Width="80"
Height="20"
Margin="0,0,0,0"
TabIndex="0"
FontFamily="Arial Rounded MT" 
FontSize="14" Click="btnRetirar_Click" HorizontalAlignment="Center">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE47C25"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="10"
  HorizontalAlignment="Left"
  Orientation="Horizontal"
  Margin="5,5,0,5" Grid.Column="3" >
            <Button x:Name="btnVaciar"
Content="Vaciar"
IsDefault="True"
Width="80"
Height="20"
Margin="0,0,0,0"
TabIndex="0"
FontFamily="Arial Rounded MT" 
FontSize="14" Click="btnVaciar_Click" HorizontalAlignment="Center">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFC42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <CheckBox x:Name="chkLog" Content="Mostar log" Grid.Row="11" HorizontalAlignment="Right" FontFamily="Arial Rounded MT" FontSize="14" VerticalAlignment="Center" Checked="chkLog_Checked" Unchecked="chkLog_Unchecked"/>

        <StackPanel Grid.Row="11"
  HorizontalAlignment="Right"
  Orientation="Horizontal"
  Margin="0,5,5,5" Grid.Column="1" Grid.ColumnSpan="2">
            <Button x:Name="btRestablecer"
Content="Restablecer"
IsDefault="True"
Width="90"
Height="20"
Margin="0,0,0,0"
TabIndex="0"
FontFamily="Arial Rounded MT" 
FontSize="14" Click="btnRestablecer_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFC42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="11"
        HorizontalAlignment="Right"
        Orientation="Horizontal"
        Margin="0,5,5,5" Grid.Column="3" >
            <Button x:Name="btnOK"
      Content="Aceptar"
      IsDefault="True"
      Width="60"
      Height="20"
      Margin="0,0,0,0"
      TabIndex="0"
      FontFamily="Arial Rounded MT" 
      FontSize="14" Click="btnOK_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1E6D0E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
