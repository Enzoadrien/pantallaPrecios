<Window x:Class="Priceio.PropiedadesImpresora"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Priceio"
        mc:Ignorable="d"
        Title="Propiedades" Height="460" Width="270" WindowStyle="None" Opacity="0.9" Background="#FFD2CBCB" AllowsTransparency="True" KeyDown="Window_KeyDown" ResizeMode="NoResize" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.DataContext>
      <local:ViewModelImpresoras/> 
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="35*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Background="#FF989090" Grid.ColumnSpan="5">
            <Label Content="Configurar impresora"  VerticalAlignment="Top" FontFamily="Arial Rounded MT" Grid.ColumnSpan="2" HorizontalAlignment="Left" FontSize="18" FontWeight="Bold"/>
        </StackPanel>
        <Button x:Name="Salir" Content="X" HorizontalAlignment="Right"  VerticalAlignment="Top"  Click="Salir_Click" Grid.Column="5" FontFamily="Arial Rounded MT" HorizontalContentAlignment="Center" Width="24" Height="24" >
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#FF989090"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFC42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Label x:Name="lblImpresora" Content="Impresora:" Grid.Row="1" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <ComboBox x:Name="cbxImpresora" ItemsSource="{Binding CmbContentImpresoras}" FontSize="14" Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,5,0" />
        <Label x:Name="lblFuente" Content="Fuente:" Grid.Row="2" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <ComboBox x:Name="cbxFuente" ItemsSource="{Binding Source={x:Static Fonts.SystemFontFamilies}}"
          FontSize="14" Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="3" SelectionChanged="cbxFuente_SelectionChanged" Margin="0,0,5,0">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock FontFamily="{Binding .}" Text="{Binding Source}" ToolTip="{Binding Source}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Label x:Name="lblTamano" Content="Tamaño:" Grid.ColumnSpan="2" Grid.Row="3" FontFamily="Arial Rounded MT" FontSize="14"/>
        <ComboBox x:Name="cbxTamano" Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="3" FontFamily="Arial Rounded MT" FontSize="14" SelectionChanged="cbxTamano_SelectionChanged" SelectedValuePath="Tag" Margin="0,0,5,0">
            <ComboBoxItem Content="8 px" Tag="8"/>
            <ComboBoxItem Content="10 px" Tag="10"/>
            <ComboBoxItem Content="12 px" Tag="12"/>
            <ComboBoxItem Content="14 px" Tag="14"/>
            <ComboBoxItem Content="16 px" Tag="16"/>
            <ComboBoxItem Content="18 px" Tag="18"/>
            <ComboBoxItem Content="20 px" Tag="20"/>
            <ComboBoxItem Content="22 px" Tag="22"/>
            <ComboBoxItem Content="24 px" Tag="24"/>
            <ComboBoxItem Content="26 px" Tag="26"/>
            <ComboBoxItem Content="28 px" Tag="28"/>
            <ComboBoxItem Content="30 px" Tag="30"/>
            <ComboBoxItem Content="32 px" Tag="32"/>
            <ComboBoxItem Content="34 px" Tag="34"/>
            <ComboBoxItem Content="36 px" Tag="36"/>
            <ComboBoxItem Content="38 px" Tag="38"/>
            <ComboBoxItem Content="40 px" Tag="40"/>
            <ComboBoxItem Content="42 px" Tag="42"/>
            <ComboBoxItem Content="44 px" Tag="44"/>
            <ComboBoxItem Content="46 px" Tag="46"/>
            <ComboBoxItem Content="48 px" Tag="48"/>
            <ComboBoxItem Content="50 px" Tag="50"/>
            <ComboBoxItem Content="52 px" Tag="52"/>
            <ComboBoxItem Content="54 px" Tag="54"/>
            <ComboBoxItem Content="56 px" Tag="56"/>
            <ComboBoxItem Content="58 px" Tag="58"/>
            <ComboBoxItem Content="60 px" Tag="60"/>
            <ComboBoxItem Content="62 px" Tag="62"/>
            <ComboBoxItem Content="64 px" Tag="64"/>
            <ComboBoxItem Content="66 px" Tag="66"/>
            <ComboBoxItem Content="68 px" Tag="68"/>
            <ComboBoxItem Content="70 px" Tag="70"/>
            <ComboBoxItem Content="72 px" Tag="72"/>
            <ComboBoxItem Content="74 px" Tag="74"/>
            <ComboBoxItem Content="76 px" Tag="76"/>
            <ComboBoxItem Content="78 px" Tag="78"/>
            <ComboBoxItem Content="80 px" Tag="80"/>
            <ComboBoxItem Content="82 px" Tag="82"/>
            <ComboBoxItem Content="84 px" Tag="84"/>
            <ComboBoxItem Content="86 px" Tag="86"/>
            <ComboBoxItem Content="88 px" Tag="88"/>
            <ComboBoxItem Content="90 px" Tag="90"/>
            <ComboBoxItem Content="92 px" Tag="92"/>
            <ComboBoxItem Content="94 px" Tag="94"/>
            <ComboBoxItem Content="96 px" Tag="96"/>
            <ComboBoxItem Content="98 px" Tag="98"/>
            <ComboBoxItem Content="100 px" Tag="100"/>
            <ComboBoxItem Content="110 px" Tag="110"/>
            <ComboBoxItem Content="120 px" Tag="120"/>
            <ComboBoxItem Content="130 px" Tag="130"/>
            <ComboBoxItem Content="140 px" Tag="140"/>
            <ComboBoxItem Content="150 px" Tag="150"/>
        </ComboBox>
        <CheckBox x:Name="chkNegrita" Content="Negrita" Grid.Row="4" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" Checked="chkNegrita_Checked" HorizontalAlignment="Center" Unchecked="chkNegrita_Unchecked" VerticalAlignment="Center" FontWeight="Bold"/>
        <CheckBox x:Name="chkCursiva" Content="Cursiva" Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" Checked="chkCursiva_Checked" Unchecked="chkCursiva_Unchecked" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic"/>
        <Label x:Name="lblLetraDemo" Content="** Ejemplo de la letra en el ticket **" Grid.ColumnSpan="5" Grid.Row="5" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Center"/>
        <Label x:Name="lblLogo" Content="Logo" Grid.ColumnSpan="2" Grid.Row="6" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="2"/>
        <Label x:Name="lblAbrir" Content="Abrir imagen:" Grid.ColumnSpan="2" Grid.Row="7" FontFamily="Arial Rounded MT" FontSize="14"/>
        <Button x:Name="btnAbrir"
Content="..."
Click="btnAbrir_Click"
IsDefault="True"
Margin="0,0,5,0"
TabIndex="0"
FontFamily="Arial Rounded MT" 
FontSize="14" Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="3">
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#FF989090"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF0E596D"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Label x:Name="lblTamanoLogo" Content="Tamaño:" Grid.ColumnSpan="2" Grid.Row="8" FontFamily="Arial Rounded MT" FontSize="14"/>
        <ComboBox x:Name="cbxTamanoLogo" Grid.Column="2" Grid.Row="8" Grid.ColumnSpan="3" FontFamily="Arial Rounded MT" FontSize="14" SelectionChanged="cbxTamanoLogo_SelectionChanged" SelectedValuePath="Tag" Margin="0,0,5,0">
            <ComboBoxItem Content="10 px" Tag="10"/>
            <ComboBoxItem Content="20 px" Tag="20"/>
            <ComboBoxItem Content="30 px" Tag="30"/>
            <ComboBoxItem Content="40 px" Tag="40"/>
            <ComboBoxItem Content="50 px" Tag="50"/>
            <ComboBoxItem Content="60 px" Tag="60"/>
            <ComboBoxItem Content="70 px" Tag="70"/>
            <ComboBoxItem Content="80 px" Tag="80"/>
            <ComboBoxItem Content="90 px" Tag="90"/>
            <ComboBoxItem Content="100 px" Tag="100"/>
            <ComboBoxItem Content="110 px" Tag="110"/>
            <ComboBoxItem Content="120 px" Tag="120"/>
            <ComboBoxItem Content="130 px" Tag="130"/>
            <ComboBoxItem Content="140 px" Tag="140"/>
            <ComboBoxItem Content="150 px" Tag="150"/>
        </ComboBox>   
            <Grid Grid.Row="9" Grid.Column="1" Grid.RowSpan="6" Grid.ColumnSpan="3" Background="White" Width="150" Height="150">
            <Border x:Name="TamanoImg" BorderThickness="1" Grid.Column="3" Grid.ColumnSpan="2" Grid.RowSpan="2" Grid.Row="7" BorderBrush="Black" Background="White" Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="imgLogo"/>
            </Border>
        </Grid>
        <StackPanel Grid.Row="15"
        HorizontalAlignment="Left"
        Orientation="Horizontal"
        Margin="5,5,0,5" Grid.ColumnSpan="3" >
            <Button x:Name="btnPrueba"
      Content="Imprimir pueba"
      IsDefault="True"
      Width="120"
      Height="20"
      Margin="0,0,0,0"
      TabIndex="4"
      FontFamily="Arial Rounded MT" 
      FontSize="14" Click="btnPrueba_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF0E596D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="15"
        HorizontalAlignment="Right"
        Orientation="Horizontal"
        Margin="0,5,5,5" Grid.Column="3" Grid.ColumnSpan="2" >
            <Button x:Name="btnOK"
      Content="Aceptar"
      IsDefault="True"
      Width="60"
      Height="20"
      Margin="0,0,0,0"
      TabIndex="0"
      FontFamily="Arial Rounded MT" 
      FontSize="14" Click="btnOK_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1E6D0E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
