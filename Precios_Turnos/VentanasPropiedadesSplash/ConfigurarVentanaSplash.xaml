<Window x:Class="Priceio.ConfigurarVentanaSplash"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Priceio"
        mc:Ignorable="d"
         Title="Configurar ventana splash" Background="#FFD2CBCB" Height="610" Width="350" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" KeyDown="Window_KeyDown" Loaded="Window_Loaded" MouseLeftButtonDown="Window_MouseLeftButtonDown" Closed="Window_Closed">
    <Window.DataContext>
        <local:ViewModelAudio/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="35*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Background="#FF989090" Grid.ColumnSpan="4">
            <Label x:Name="Titulo" Content="Configurar ventana splash"  VerticalAlignment="Top" FontFamily="Arial Rounded MT" HorizontalAlignment="Left" FontSize="18" FontWeight="Bold"/>
        </StackPanel>
        <Button x:Name="Salir" Content="X" HorizontalAlignment="Right"  VerticalAlignment="Top"  Click="Salir_Click" Grid.Column="3" FontFamily="Arial Rounded MT" HorizontalContentAlignment="Center" Width="24" Height="24" >
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#FF989090"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFC42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Label x:Name="lblTipoVentana" Content="Tipo de ventana:" Grid.Row="1" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <ComboBox x:Name="cbxTipoSplash" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" SelectedValuePath="Tag" SelectedIndex="0" Margin="0,0,5,0" SelectionChanged="cbxTipoSplash_SelectionChanged">
            <ComboBoxItem Content="Turnero" Tag="T"/>
            <ComboBoxItem Content="Verificador" Tag="V"/>
            <ComboBoxItem Content="Cajero ATM" Tag="C"/>
        </ComboBox>
        <Label x:Name="lblAudio" Content="Audio:" Grid.Row="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <ComboBox x:Name="cbxAudio" ItemsSource="{Binding CmbContentAudio}" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,5,0" SelectionChanged="cbxAudio_SelectionChanged" SelectedIndex="0"/>
        <Label x:Name="lblDurar" Content="Durar:" Grid.Row="3" FontFamily="Arial Rounded MT" FontSize="14"/>
        <TextBox x:Name="Durar" Grid.Row="3" Text="5" Grid.Column="1" VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown" />
        <Label x:Name="lblSeg" Content="s" Grid.Row="3" Grid.Column="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <Label x:Name="lblTamano" Content="Tamaño ventana" Grid.Row="4" Grid.Column="1" FontFamily="Arial Rounded MT" FontSize="14" Grid.ColumnSpan="2"/>
        <Label x:Name="lblAncho" Content="Ancho" Grid.Row="5" FontFamily="Arial Rounded MT" FontSize="14"/>
        <TextBox x:Name="Ancho" Grid.Row="5" Text="600" Grid.Column="1" VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown" />
        <Label x:Name="lblAlto" Content="Alto" Grid.Row="5" Grid.Column="2" FontFamily="Arial Rounded MT" FontSize="14"/>
        <TextBox x:Name="Alto" Grid.Row="5" Text="600" Grid.Column="3" VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown" Margin="0,0,5,0" />
        <CheckBox x:Name="chkVoz" Content="Voz de Windows" Grid.Row="6" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Margin="5,0,0,0" Checked="chkVoz_Checked" Unchecked="chkVoz_Unchecked"/>
        <StackPanel Grid.Row="6"
  HorizontalAlignment="Right"
  Orientation="Horizontal"
  Margin="0,5,5,5" Grid.Column="2" Grid.ColumnSpan="2">
            <Button x:Name="btnVoz"
Content="Configurar voz"
IsDefault="True"
Width="120"
Height="20"
Margin="0,0,0,0"
TabIndex="0"
FontFamily="Arial Rounded MT" 
FontSize="14" Click="btnVoz_Click" Visibility="Hidden">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF0E596D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <TabControl x:Name="TiposVentana" Grid.Row="7" Grid.RowSpan="10" Grid.ColumnSpan="4" Margin="5,0,5,0">
            <TabItem x:Name="Turnero" Header="Turnero" FontFamily="Arial Rounded MT" FontSize="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40*"/>
                        <ColumnDefinition Width="40*"/>
                        <ColumnDefinition Width="40*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <!-- ← FILA NUEVA para impresora -->
                    </Grid.RowDefinitions>

                    <Label x:Name="lblTipo" Content="Tipo:" FontFamily="Arial Rounded MT" FontSize="14"/>
                    <ComboBox x:Name="cbxTipo" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="1" Grid.ColumnSpan="2" SelectedValuePath="Tag" Margin="0,0,5,0" SelectionChanged="cbxTipo_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="Servidor" Tag="S"/>
                        <ComboBoxItem Content="Cliente" Tag="C"/>
                    </ComboBox>

                    <Label x:Name="lblProtocolo" Content="Protocolo:" Grid.Row="1" FontFamily="Arial Rounded MT" FontSize="14"/>
                    <ComboBox x:Name="cbxProtocolo" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" SelectedValuePath="Tag" Margin="0,0,5,0" SelectedIndex="0">
                        <ComboBoxItem Content="Teclado PC" Tag="T"/>
                        <ComboBoxItem Content="API" Tag="A"/>
                        <ComboBoxItem Content="Kretz" Tag="K"/>
                    </ComboBox>

                    <Label x:Name="lblPuerto" Content="Puerto TCP:" Grid.Row="2" FontFamily="Arial Rounded MT" FontSize="14"/>
                    <TextBox x:Name="Puerto" Grid.Row="2" Grid.ColumnSpan="2" Text="9101" Grid.Column="1" VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" Margin="0,0,5,0" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown"/>

                    <Label x:Name="lblTurnosAnt" Content="Turnos anteriores:" Grid.Row="3" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
                    <ComboBox x:Name="cbxTurnosAnt" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="3" SelectedValuePath="Tag" Margin="0,0,5,0" SelectedIndex="0">
                        <ComboBoxItem Content="1" Tag="1"/>
                        <ComboBoxItem Content="2" Tag="2"/>
                        <ComboBoxItem Content="3" Tag="3"/>
                        <ComboBoxItem Content="4" Tag="4"/>
                        <ComboBoxItem Content="5" Tag="5"/>
                        <ComboBoxItem Content="6" Tag="6"/>
                        <ComboBoxItem Content="7" Tag="7"/>
                        <ComboBoxItem Content="8" Tag="8"/>
                        <ComboBoxItem Content="9" Tag="9"/>
                        <ComboBoxItem Content="10" Tag="10"/>
                    </ComboBox>

                    <Label x:Name="lblIP" Content="IP base:" Grid.Row="4" FontFamily="Arial Rounded MT" FontSize="14"/>
                    <ComboBox x:Name="cbxIP" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="4" SelectedValuePath="Tag" Margin="0,0,5,0"/>

                    <StackPanel Grid.Row="5" HorizontalAlignment="Left" Orientation="Horizontal" Margin="5,5,0,5" Grid.ColumnSpan="2">
                        <Button x:Name="btnBuscar" Content="Buscar turneros" IsDefault="True" Width="120" Height="20" Margin="0,0,0,0" TabIndex="0" FontFamily="Arial Rounded MT" FontSize="14" Click="btnBuscar_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="#FF989090"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFE47C25"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="5" HorizontalAlignment="Center" Orientation="Horizontal" Margin="5,5,0,5" Grid.Column="1">
                        <Button x:Name="btnDetener" Content="Detener" IsDefault="True" Width="70" Height="20" Margin="0,0,0,0" TabIndex="0" FontFamily="Arial Rounded MT" FontSize="14" Click="btnDetener_Click" Visibility="Hidden">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="#FF989090"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFC42B1C"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <ComboBox x:Name="cbxTurneros" Grid.Column="2" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,5,0"/>

                    <Grid x:Name="gridBar" Grid.ColumnSpan="3" Grid.Row="6" Margin="5,5,5,5">
                        <ProgressBar x:Name="BarraP" Maximum="255"/>
                        <TextBlock x:Name="Progress" HorizontalAlignment="Center" VerticalAlignment="Center">0/255</TextBlock>
                    </Grid>

                    <Label x:Name="lblEncontrados" Content="Encontrados: 0" Grid.Row="7" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14"/>
                    <Label x:Name="lblIPS" Content="" Grid.Row="7" Grid.Column="2" FontFamily="Arial Rounded MT" FontSize="12"/>

                    <!-- Fila 8: Nombrar equipos y Mostrar nombres (sin cambios) -->
                    <StackPanel Grid.Row="8" HorizontalAlignment="Left" Orientation="Horizontal" Margin="5,5,0,5" Grid.ColumnSpan="2">
                        <Button x:Name="btnNombresEquipos" Content="Nombrar equipos" IsDefault="True" Width="120" Height="20" Margin="0,0,0,0" TabIndex="0" FontFamily="Arial Rounded MT" FontSize="14" Click="btnNombresEquipos_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="#FF989090"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFE47C25"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <CheckBox x:Name="chkMostrarNombres" Content="Mostrar nombres" Grid.Column="1" Grid.Row="8" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>

                    <!-- ── FILA 9 NUEVA: Botón Impresora ────────────────── -->
                    <StackPanel Grid.Row="9" HorizontalAlignment="Left" Orientation="Horizontal" Margin="5,5,0,5" Grid.ColumnSpan="2">
                        <Button x:Name="btnImpresoraTurnero" Content="Impresora" Width="120" Height="20" Margin="0,0,0,0" FontFamily="Arial Rounded MT" FontSize="14" Click="btnImpresoraTurnero_Click" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="#FF989090"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF0E596D"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <!-- ─────────────────────────────────────────────────── -->

                </Grid>
            </TabItem>
            <TabItem x:Name="Verificador" Header="Verificador" FontFamily="Arial Rounded MT" FontSize="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28*"/>
                        <ColumnDefinition Width="87*"/>
                        <ColumnDefinition Width="115*"/>
                        <ColumnDefinition Width="115*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                    </Grid.RowDefinitions>
                </Grid>
            </TabItem>
            <TabItem x:Name="CajeroATM" Header="Cajero ATM" FontFamily="Arial Rounded MT" FontSize="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40*"/>
                        <ColumnDefinition Width="40*"/>
                        <ColumnDefinition Width="40*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                        <RowDefinition Height="30*"/>
                    </Grid.RowDefinitions>
                    <Label x:Name="lblServidorCajero" Content="Servidor TCP"  FontFamily="Arial Rounded MT" FontSize="14" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Label x:Name="lblPuertoCajero" Content="Puerto:"  FontFamily="Arial Rounded MT" FontSize="14" Grid.Row="1"/>
                    <TextBox x:Name="PuertoTCPCajero" Grid.Row="1" Grid.ColumnSpan="2" Text="9101" Grid.Column="1"  VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" Margin="0,0,5,0" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown"/>
                    <Label x:Name="lblSMARTPayout" Content="SMART Payout" FontFamily="Arial Rounded MT" FontSize="14" Grid.ColumnSpan="3" HorizontalAlignment="Center" Grid.Row="2" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2"
  Orientation="Horizontal"
  Margin="5,5,5,5" Grid.ColumnSpan="2" Grid.Column="2">
                        <Button x:Name="btnPayout"
Content="Configurar"
FontFamily="Arial Rounded MT" 
FontSize="14" Width="100" Click="btnPayout_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="#FF989090"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFE47C25"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <Label x:Name="lblPuertoComNV22Spectral" Content="Puerto COM:" FontFamily="Arial Rounded MT" FontSize="14" Grid.Row="3"/>
                    <ComboBox x:Name="cbxPuertoComNV22" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="1" Grid.ColumnSpan="2" SelectedValuePath="Tag" Margin="0,0,5,0" SelectionChanged="cbxTipo_SelectionChanged" Grid.Row="3" SelectedIndex="0">
                        <ComboBoxItem Content="1" Tag="COM1"/>
                        <ComboBoxItem Content="2" Tag="COM2"/>
                        <ComboBoxItem Content="3" Tag="COM3"/>
                        <ComboBoxItem Content="4" Tag="COM4"/>
                        <ComboBoxItem Content="5" Tag="COM5"/>
                        <ComboBoxItem Content="6" Tag="COM6"/>
                        <ComboBoxItem Content="7" Tag="COM7"/>
                        <ComboBoxItem Content="8" Tag="COM8"/>
                        <ComboBoxItem Content="9" Tag="COM9"/>
                        <ComboBoxItem Content="10" Tag="COM10"/>
                    </ComboBox>
                    <Label x:Name="lblSSPNV22Spectral" Content="SSP Address:" Grid.Row="4" FontFamily="Arial Rounded MT" FontSize="14"/>
                    <TextBox x:Name="SSPNV22Spectral" Grid.Row="4" Grid.ColumnSpan="2" Text="0" Grid.Column="1"  VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" Margin="0,0,5,0" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown"/>
                    <Label x:Name="lblSMARTHopper" Content="SMART Hopper" FontFamily="Arial Rounded MT" FontSize="14" Grid.ColumnSpan="3" HorizontalAlignment="Center" Grid.Row="5" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="5"
  Orientation="Horizontal"
  Margin="5,5,5,5" Grid.ColumnSpan="2" Grid.Column="2">
                        <Button x:Name="btnHopper"
Content="Configurar"
FontFamily="Arial Rounded MT" 
FontSize="14" Width="100" Click="btnHopper_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="#FF989090"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFE47C25"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <Label x:Name="lblPuertoComSMARTHopper" Content="Puerto COM:" FontFamily="Arial Rounded MT" FontSize="14" Grid.Row="6"/>
                    <ComboBox x:Name="cbxPuertoComSMARTHopper" FontFamily="Arial Rounded MT" FontSize="14" Grid.Column="1" Grid.ColumnSpan="2" SelectedValuePath="Tag" Margin="0,0,5,0" SelectionChanged="cbxTipo_SelectionChanged" Grid.Row="6" SelectedIndex="0">
                        <ComboBoxItem Content="1" Tag="COM1"/>
                        <ComboBoxItem Content="2" Tag="COM2"/>
                        <ComboBoxItem Content="3" Tag="COM3"/>
                        <ComboBoxItem Content="4" Tag="COM4"/>
                        <ComboBoxItem Content="5" Tag="COM5"/>
                        <ComboBoxItem Content="6" Tag="COM6"/>
                        <ComboBoxItem Content="7" Tag="COM7"/>
                        <ComboBoxItem Content="8" Tag="COM8"/>
                        <ComboBoxItem Content="9" Tag="COM9"/>
                        <ComboBoxItem Content="10" Tag="COM10"/>
                    </ComboBox>
                    <Label x:Name="lblSSPSMARTHopper" Content="SSP Address:" Grid.Row="7" FontFamily="Arial Rounded MT" FontSize="14"/>
                    <TextBox x:Name="SSPSMARTHopper" Grid.Row="7" Grid.ColumnSpan="2" Text="16" Grid.Column="1"  VerticalContentAlignment="Center" FontFamily="Arial Rounded MT Bold" FontSize="14" Margin="0,0,5,0" PreviewTextInput="ResponseTextBox_PreviewTextInput" DataObject.Pasting="PastingHandler" PreviewKeyDown="ResponseTextBox_PreviewKeyDown"/>
                    <StackPanel Grid.Row="8"
  HorizontalAlignment="Left"
  Orientation="Horizontal"
  Margin="5,5,0,5" Grid.ColumnSpan="2" >
                        <Button x:Name="btnImpresora"
Content="Impresora"
IsDefault="True"
Width="120"
Height="20"
Margin="0,0,0,0"
TabIndex="0"
FontFamily="Arial Rounded MT" 
FontSize="14" Click="btnImpresora_Click" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="#FF989090"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF0E596D"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="8"
  HorizontalAlignment="Right"
  Orientation="Horizontal"
  Margin="5,5,5,5" Grid.Column="1" >
                        <Button x:Name="btnLector"
Content="Lector"
IsDefault="True"
Width="80"
Height="20"
Margin="0,0,0,0"
TabIndex="0"
FontFamily="Arial Rounded MT" 
FontSize="14" VerticalAlignment="Center" Click="btnLector_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="#FF989090"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF0E596D"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <CheckBox x:Name="chkLogPagos" Content="Mostrar log" Grid.Row="8" Grid.Column="2" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                </Grid>
            </TabItem>
        </TabControl>
        <CheckBox x:Name="chkActivarSplash" Content="Activar" Grid.Row="17" Grid.ColumnSpan="2" FontFamily="Arial Rounded MT" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
        <StackPanel Grid.Row="17"
         HorizontalAlignment="Right"
         Orientation="Horizontal"
         Margin="0,5,5,5" Grid.Column="1" Grid.ColumnSpan="2">
            <Button x:Name="btRestablecer"
       Content="Restablecer"
       IsDefault="True"
       Width="90"
       Height="20"
       Margin="0,0,0,0"
       TabIndex="0"
       FontFamily="Arial Rounded MT" 
       FontSize="14" Click="btnRestablecer_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFC42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="17"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Margin="0,5,5,5" Grid.Column="3" >
            <Button x:Name="btnOK"
              Content="Aceptar"
              IsDefault="True"
              Width="60"
              Height="20"
              Margin="0,0,0,0"
              TabIndex="0"
              FontFamily="Arial Rounded MT" 
              FontSize="14" Click="btnOK_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Background" Value="#FF989090"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1E6D0E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
